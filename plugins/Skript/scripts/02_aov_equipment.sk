    set {_gtk} to createAoVItem("giap_thong_kho")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6120 Coin" and "" and "&a▸ Nhấn để Rèn Giáp Thống Khổ!" to lore of {_gtk}
    if hasAoVItemInTray({_p}, "giap_thong_kho") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_gtk}
    set slot 19 of {_p}'s current inventory to {_gtk}

    set {_ktt} to createAoVItem("khien_that_truyen")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6120 Coin" and "" and "&a▸ Nhấn để Rèn Khiên Thất Truyền!" to lore of {_ktt}
    if hasAoVItemInTray({_p}, "khien_that_truyen") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_ktt}
    set slot 20 of {_p}'s current inventory to {_ktt}

    set {_gaia} to createAoVItem("giap_gaia")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6200 Coin" and "" and "&a▸ Nhấn để Rèn Giáp Gaia!" to lore of {_gaia}
    if hasAoVItemInTray({_p}, "giap_gaia") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_gaia}
    set slot 21 of {_p}'s current inventory to {_gaia}

    set {_troy} to createAoVItem("huan_chuong_troy")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6200 Coin" and "" and "&a▸ Nhấn để Rèn Huân Chương Troy!" to lore of {_troy}
    if hasAoVItemInTray({_p}, "huan_chuong_troy") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_troy}
    set slot 22 of {_p}'s current inventory to {_troy}

    set {_ghm} to createAoVItem("giap_ho_menh")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6350 Coin" and "" and "&a▸ Nhấn để Rèn Giáp Hộ Mệnh!" to lore of {_ghm}
    if hasAoVItemInTray({_p}, "giap_ho_menh") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_ghm}
    set slot 23 of {_p}'s current inventory to {_ghm}

    set {_pcts} to createAoVItem("phu_chu_truong_sinh")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6300 Coin" and "" and "&a▸ Nhấn để Rèn Phù Chú Trường Sinh!" to lore of {_pcts}
    if hasAoVItemInTray({_p}, "phu_chu_truong_sinh") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_pcts}
    set slot 24 of {_p}'s current inventory to {_pcts}

    # Slot 49: Hiển thị Số Dư Coin & Thông Tin Thợ Rèn
    delete {_balLore::*}
    set {_balLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_balLore::2} to "&7Số dư Coin: &6%routerFormatNumber(getCoinBalance({_p}))% ⛁"
    set {_balLore::3} to "&7Dùng Coin để rèn trang bị Liên Quân độc quyền!"
    set {_balLore::4} to "&e▸ Đổi Money thành Coin tại &a/nganhang&e!"
    set {_balLore::5} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 49 of {_p}'s current inventory to makeGlowingItem(sunflower, "&e&l✦ SỐ DƯ COIN & RÈN AOV ✦", {_balLore::*})

function craftAoVItem(p: player, id: text):
    set {_item} to createAoVItem({_id})
    if {_item} is air:
        stop

    set {_cost} to getAoVCoinPrice({_id})
    if {_cost} <= 0:
        stop

    if getCoinBalance({_p}) < {_cost}:
        sendSystemMsg({_p}, "error", "Bạn thiếu Coin! Cần %{_cost}% Coin để rèn (Đổi tại /nganhang).")
        play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
        stop

    takeCoinBalance({_p}, {_cost})
    giveItemSafely({_p}, {_item})

    set {_craftedName} to getAoVItemName({_id})
    sendSystemMsg({_p}, "economy", "Rèn thành công %{_craftedName}%&f! (-%{_cost}% Coin)")
    play sound "BLOCK_ANVIL_USE" with volume 1 and pitch 1 to {_p}
    play sound "ENTITY_PLAYER_LEVELUP" with volume 0.8 and pitch 1.3 to {_p}
    set {_loc} to location of {_p}
    add 1 to y-coordinate of {_loc}
    spawnVisualParticle("FIREWORKS_SPARK", {_loc}, 20, 0.4, 0.5, 0.4, 0.08)
    refreshAoVShopGUI({_p})

on inventory click:
    set {_u} to uuid of player
    if {ui_active::%{_u}%} is not "UI_G3_C":
        stop
    cancel event
    if "%click type%" contains "SHIFT" or "NUMBER" or "DOUBLE" or "SWAP" or "DROP":
        player.updateInventory()
    if clicked inventory is not player's current inventory:
        stop

    set {_slot} to index of event-slot
    if {_slot} is 45 or 46 or 53:
        stop

    if {_slot} is 4:
        if getCoinBalance(player) < 160:
            sendSystemMsg(player, "error", "Bạn thiếu Coin! Cần 160 Coin để mua Rương Trang Bị AoV (Đổi tại /nganhang).")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
            stop
        takeCoinBalance(player, 160)
        set {_chest} to createAoVChest()
        giveItemSafely(player, {_chest})
        sendSystemMsg(player, "forge", "Đã mua thành công &6&lRương Trang Bị AoV&f! (-160 Coin)")
        play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.2 to player
        refreshAoVShopGUI(player)
    else if {_slot} is 10:
        craftAoVItem(player, "thanh_kiem")
    else if {_slot} is 11:
        craftAoVItem(player, "muramasa")
    else if {_slot} is 12:
        craftAoVItem(player, "nanh_fenrir")
    else if {_slot} is 13:
        craftAoVItem(player, "song_dao")
    else if {_slot} is 14:
        craftAoVItem(player, "quy_kiem")
    else if {_slot} is 15:
        craftAoVItem(player, "thuong_xuyen_pha")
    else if {_slot} is 19:
        craftAoVItem(player, "giap_thong_kho")
    else if {_slot} is 20:
        craftAoVItem(player, "khien_that_truyen")
    else if {_slot} is 21:
        craftAoVItem(player, "giap_gaia")
    else if {_slot} is 22:
        craftAoVItem(player, "huan_chuong_troy")
    else if {_slot} is 23:
        craftAoVItem(player, "giap_ho_menh")
    else if {_slot} is 24:
        craftAoVItem(player, "phu_chu_truong_sinh")

# ---------------------------------------------------------------------
# 7. CHỐNG KÉO THẢ GUI QUA REFLECT (INVENTORY DRAG EVENT)
# ---------------------------------------------------------------------
on InventoryDragEvent:
    set {_who} to event.getWhoClicked()
    if {_who} is set:
        set {_active} to {ui_active::%uuid of {_who}%}
        if {_active} is "UI_G3_A" or "UI_G3_B" or "UI_G3_C":
            cancel event

# ---------------------------------------------------------------------
# 8. VÒNG LẶP ĐỊNH KỲ NỘI TẠI NGOÀI GIAO TRANH & HỒI SINH (EVERY 2 SECONDS)
# ---------------------------------------------------------------------
every 2 seconds:
    set {_nowMs} to System.currentTimeMillis()
    loop all players:
        set {_u} to uuid of loop-player
        if loop-player is not alive:
            delete {aov_revive_pending::%{_u}%}
            continue
        if health of loop-player <= 0:
            delete {aov_revive_pending::%{_u}%}
            continue

        # 1. Huân Chương Troy: Tạo khiên Hấp Thụ (Absorption I 10s) mỗi 15s
        if {aov_bonus::%{_u}%::has_troy} is true:
            set {_can_troy} to true
            if {aov_cd_ms::%{_u}%::troy} is set:
                if ({_nowMs} - {aov_cd_ms::%{_u}%::troy}) < 15000:
                    set {_can_troy} to false
            if {_can_troy} is true:
                set {aov_cd_ms::%{_u}%::troy} to {_nowMs}
                apply absorption 1 to loop-player for 10 seconds
                set {_ploc} to location of loop-player
                add 1 to y-coordinate of {_ploc}
                spawnVisualParticle("SPELL_MOB", {_ploc}, 8, 0.3, 0.4, 0.3, 0.05)

        # 2. Kiểm tra rời giao tranh sau 5 giây (Out of combat >= 5s)
        set {_ooc} to false
        if {last_combat::%{_u}%} is not set:
            set {_ooc} to true
        else if difference between {last_combat::%{_u}%} and now >= 5 seconds:
            set {_ooc} to true

        if {_ooc} is true:
            if {aov_bonus::%{_u}%::has_xuyenpha} is true:
                apply speed 1 to loop-player for 3 seconds

            if {aov_bonus::%{_u}%::has_truongsinh} is true:
                set {_can_ts_heal} to true
                if {mera_curse_until::%{_u}%} is set:
                    if System.currentTimeMillis() < {mera_curse_until::%{_u}%}:
                        set {_can_ts_heal} to false
                    else:
                        delete {mera_curse_until::%{_u}%}
                if {_can_ts_heal} is true:
                    if health of loop-player > 0:
                        if health of loop-player < max health of loop-player:
                            set {_h_amt} to (max health of loop-player) * 0.024
                            heal loop-player by {_h_amt}
                            set {_ploc2} to location of loop-player
                            add 1 to y-coordinate of {_ploc2}
                            spawnVisualParticle("VILLAGER_HAPPY", {_ploc2}, 3, 0.3, 0.4, 0.3, 0.05)

        # 3. Giáp Hộ Mệnh: Hồi phục 40% Máu tối đa (Bảo vệ dự phòng nếu chưa hồi phục tức thì)
        if {aov_revive_pending::%{_u}%} is set:
            if difference between {aov_revive_pending::%{_u}%} and now >= 2 seconds:
                delete {aov_revive_pending::%{_u}%}
                if loop-player is alive:
                    if health of loop-player > 0:
                        set {_heal_res} to (max health of loop-player) * 0.40
                        if {aov_bonus::%{_u}%::has_truongsinh} is true:
                            set {_heal_res} to {_heal_res} * 1.2
                        heal loop-player by {_heal_res}
                        send action bar "&a&l✦ GIÁP HỘ MỆNH: HỒI ĐẦY 40%% MÁU TỐI ĐA! ✦" to loop-player
                        play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.3 to loop-player
                        set {_rloc} to location of loop-player
                        add 1 to y-coordinate of {_rloc}
                        spawnVisualParticle("FIREWORKS_SPARK", {_rloc}, 25, 0.4, 0.6, 0.4, 0.08)

# ---------------------------------------------------------------------
# 9. LỆNH QUẢN TRỊ VIÊN TRANG BỊ LIÊN QUÂN (/aovadmin)
# ---------------------------------------------------------------------
command /aovadmin <text> [<player>] [<text>] [<number>]:
    permission: op
    permission message: &cBạn không có quyền sử dụng lệnh này!
    trigger:
        if arg-1 is "give":
            if arg-2 is not set:
                sendSystemMsg(sender, "error", "Cú pháp: /aovadmin give <player> <item_id> [amount]")
                stop
            if arg-3 is not set:
                sendSystemMsg(sender, "error", "Thiếu ID trang bị! Gõ /aovadmin list để xem danh sách.")
                stop
            set {_item} to createAoVItem(arg-3)
            if {_item} is air:
                sendSystemMsg(sender, "error", "ID trang bị '%arg-3%' không tồn tại! Gõ /aovadmin list.")
                stop
            set {_amt} to 1
            if arg-4 is set:
                set {_amt} to floor(arg-4)
            if {_amt} < 1:
                set {_amt} to 1
            loop {_amt} times:
                if arg-2 can hold {_item}:
                    give {_item} to arg-2
                else:
                    drop {_item} at location of arg-2
            set {_givenName} to getAoVItemName(arg-3)
            sendSystemMsg(sender, "economy", "Đã trao &6%{_amt}%x %{_givenName}% &fcho &e%name of arg-2%&f!")
            play sound "ENTITY_EXPERIENCE_ORB_PICKUP" with volume 1 and pitch 1.2 to arg-2

        else if arg-1 is "list":
            send "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" to sender
            send "&6&lDANH SÁCH 12 TRANG BỊ LIÊN QUÂN:" to sender
            send "&c• Công Vật Lý: &fthanh_kiem, muramasa, nanh_fenrir, song_dao, quy_kiem, thuong_xuyen_pha" to sender
            send "&9• Phòng Thủ: &fgiap_thong_kho, khien_that_truyen, giap_gaia, huan_chuong_troy, giap_ho_menh, phu_chu_truong_sinh" to sender
            send "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" to sender

        else if arg-1 is "clear":
            if arg-2 is not set:
                sendSystemMsg(sender, "error", "Cú pháp: /aovadmin clear <player>")
                stop
            set {_u} to uuid of arg-2
            delete {aov_slot::%{_u}%::*}
            delete {aov_equip::%{_u}%::*}
            recalcAoVBonuses(arg-2)
            sendSystemMsg(sender, "combat", "Đã xóa sạch Khay Trang Bị của &e%name of arg-2%&f!")

        else:
            send "&e&lLệnh /aovadmin:" to sender
            send "&7• /aovadmin give <player> <item_id> [amount]" to sender
            send "&7• /aovadmin list &8- Xem 12 ID trang bị" to sender
            send "&7• /aovadmin clear <player> &8- Xóa khay trang bị" to sender

# ---------------------------------------------------------------------
# 10. RƯƠNG TRANG BỊ LIÊN QUÂN 3D & LỆNH /ghepthe CHUYỂN HƯỚNG
# ---------------------------------------------------------------------
function createAoVChest() :: item:
    set {_lore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_lore::2} to "&7Loại: &6Bảo Vật Sử Thi &8(Liên Quân)"
    set {_lore::3} to "&7Khi mở, nhận ngẫu nhiên &61 trong 12"
    set {_lore::4} to "&7Trang Bị Liên Quân cực phẩm!"
    set {_lore::5} to ""
    set {_lore::6} to "&e▸ Chuột Phải để mở Rương!"
    set {_lore::7} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_item} to makeCustomRPItem("aov_chest", "&6&l✦ RƯƠNG TRANG BỊ LIÊN QUÂN ✦", {_lore::*})
    set string tag "AoVChest" of nbt compound of {_item} to "true"
    set string tag "SkyblockItem" of nbt compound of {_item} to "aov_chest"
    return {_item}

command /aovchest <text> [<player>] [<number>]:
    permission: op
    permission message: &cBạn không có quyền sử dụng lệnh này!
    trigger:
        if arg-1 is "give":
            if arg-2 is not set:
                sendSystemMsg(sender, "error", "Cú pháp: /aovchest give <player> [amount]")
                stop
            set {_amt} to 1
            if arg-3 is set:
                set {_amt} to floor(arg-3)
            if {_amt} < 1:
                set {_amt} to 1
            set {_c} to createAoVChest()
            loop {_amt} times:
                if arg-2 can hold {_c}:
                    give {_c} to arg-2
                else:
                    drop {_c} at location of arg-2
            sendSystemMsg(sender, "economy", "Đã trao &6%{_amt}%x Rương Trang Bị LQ &fcho &e%name of arg-2%&f!")

on rightclick:
    set {_tool} to player's tool
    if {_tool} is not set:
        stop
    if {_tool} is air:
        stop
    if type of {_tool} is air:
        stop

    set {_tag} to string tag "AoVChest" of nbt compound of {_tool}
    if {_tag} is "true":
        cancel event
        set {_amt} to {_tool}.getAmount()
        if {_amt} <= 1:
            set player's tool to air
        else:
            set item amount of player's tool to ({_amt} - 1)

        set {_pool::1} to "thanh_kiem"
        set {_pool::2} to "muramasa"
        set {_pool::3} to "nanh_fenrir"
        set {_pool::4} to "song_dao"
        set {_pool::5} to "quy_kiem"
        set {_pool::6} to "thuong_xuyen_pha"
        set {_pool::7} to "giap_thong_kho"
        set {_pool::8} to "khien_that_truyen"
        set {_pool::9} to "giap_gaia"
        set {_pool::10} to "huan_chuong_troy"
        set {_pool::11} to "giap_ho_menh"
        set {_pool::12} to "phu_chu_truong_sinh"

        set {_rand} to random integer between 1 and 12
        set {_pick_id} to {_pool::%{_rand}%}
        set {_reward} to createAoVItem({_pick_id})

        if player can hold {_reward}:
            give {_reward} to player
        else:
            drop {_reward} at location of player

        set {_rewardName} to getAoVItemName({_pick_id})
        sendSystemMsg(player, "economy", "Chúc mừng! Bạn đã mở được %{_rewardName}%&f!")
        play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.3 to player
        set {_loc} to location of player
        add 1 to y-coordinate of {_loc}
        spawnVisualParticle("FIREWORKS_SPARK", {_loc}, 30, 0.5, 0.8, 0.5, 0.1)

command /ghepthe:
    aliases: /mergecards
    trigger:
        sendSystemMsg(player, "combat", "Hệ thống Thẻ Thiên Phú đã nâng cấp lên Trang Bị Liên Quân!")
        sendSystemMsg(player, "combat", "Đang mở Xưởng Rèn Liên Quân (/shopaov)...")
        openAoVShopGUI(player)

on join:
    wait 5 ticks
    if player is online:
        recalcAoVBonuses(player)