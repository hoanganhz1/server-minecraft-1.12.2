function getAoVItemId(i: object) :: text:
    if {_i} is not set:
        return ""
    if {_i} is air:
        return ""
    if type of {_i} is air:
        return ""
    if {_i} is an instance of ItemStack:
        if {_i}.getAmount() <= 0:
            return ""
    else:
        if item amount of {_i} <= 0:
            return ""
    set {_tag} to string tag "AoVItem" of nbt compound of {_i}
    if {_tag} is set:
        return {_tag}
    return ""

function getAoVItemName(id: text) :: text:
    if {_id} is "thanh_kiem":
        return "&6&lThánh Kiếm"
    if {_id} is "muramasa":
        return "&b&lKiếm Muramasa"
    if {_id} is "nanh_fenrir":
        return "&c&lNanh Fenrir"
    if {_id} is "song_dao":
        return "&a&lSong Đao Bão Táp"
    if {_id} is "quy_kiem":
        return "&4&lQuỷ Kiếm"
    if {_id} is "thuong_xuyen_pha":
        return "&e&lThương Xuyên Phá"
    if {_id} is "giap_thong_kho":
        return "&c&lGiáp Thống Khổ"
    if {_id} is "khien_that_truyen":
        return "&6&lKhiên Thất Truyền"
    if {_id} is "giap_gaia":
        return "&a&lGiáp Gaia"
    if {_id} is "huan_chuong_troy":
        return "&e&lHuân Chương Troy"
    if {_id} is "giap_ho_menh":
        return "&6&lGiáp Hộ Mệnh"
    if {_id} is "phu_chu_truong_sinh":
        return "&d&lPhù Chú Trường Sinh"
    return "&6Trang Bị Liên Quân"

# Tự động di trú dữ liệu cũ (nếu {aov_slot::*} đang lưu ItemStack thì chuyển thành String ID)
function migrateAoVSlotToId(u: text, idx: number) :: text:
    set {_val} to {aov_slot::%{_u}%::%{_idx}%}
    if {_val} is not set:
        return ""
    if {_val} is a text:
        return {_val}
    set {_extracted} to getAoVItemId({_val})
    if {_extracted} is not "":
        set {aov_slot::%{_u}%::%{_idx}%} to {_extracted}
        return {_extracted}
    delete {aov_slot::%{_u}%::%{_idx}%}
    return ""

# ---------------------------------------------------------------------
# 3. ĐỒNG BỘ CHỈ SỐ TRANG BỊ LIÊN QUÂN (RECALC AOV BONUSES)
# ---------------------------------------------------------------------
function recalcAoVBonuses(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_max} to getMaxAoVSlots({_p})

    set {aov_bonus::%{_u}%::damage} to 0.0
    set {aov_bonus::%{_u}%::crit_chance} to 0.0
    set {aov_bonus::%{_u}%::crit_damage} to 0.0
    set {aov_bonus::%{_u}%::armor_pen} to 0.0
    set {aov_bonus::%{_u}%::lifesteal} to 0.0
    set {aov_bonus::%{_u}%::hp} to 0.0
    set {aov_bonus::%{_u}%::def} to 0.0
    set {aov_bonus::%{_u}%::cdr} to 0.0
    set {aov_bonus::%{_u}%::speed} to 0.0
    set {aov_bonus::%{_u}%::heal_bonus} to 0.0
    set {aov_bonus::%{_u}%::cdr_overflow} to 0.0

    delete {aov_bonus::%{_u}%::has_thanhkiem}
    delete {aov_bonus::%{_u}%::has_muramasa}
    delete {aov_bonus::%{_u}%::has_fenrir}
    delete {aov_bonus::%{_u}%::has_songdao}
    delete {aov_bonus::%{_u}%::has_quykiem}
    delete {aov_bonus::%{_u}%::has_xuyenpha}
    delete {aov_bonus::%{_u}%::has_thongkho}
    delete {aov_bonus::%{_u}%::has_thatruyen}
    delete {aov_bonus::%{_u}%::has_gaia}
    delete {aov_bonus::%{_u}%::has_troy}
    delete {aov_bonus::%{_u}%::has_homenh}
    delete {aov_bonus::%{_u}%::has_truongsinh}

    loop integers from 1 to {_max}:
        set {_id} to migrateAoVSlotToId({_u}, loop-integer)
        if {_id} is "thanh_kiem":
            add 5.0 to {aov_bonus::%{_u}%::damage}
            add 25.0 to {aov_bonus::%{_u}%::crit_chance}
            add 40.0 to {aov_bonus::%{_u}%::crit_damage}
            set {aov_bonus::%{_u}%::has_thanhkiem} to true
        else if {_id} is "muramasa":
            add 4.0 to {aov_bonus::%{_u}%::damage}
            add 10.0 to {aov_bonus::%{_u}%::cdr}
            add 35.0 to {aov_bonus::%{_u}%::armor_pen}
            set {aov_bonus::%{_u}%::has_muramasa} to true
        else if {_id} is "nanh_fenrir":
            add 6.5 to {aov_bonus::%{_u}%::damage}
            set {aov_bonus::%{_u}%::has_fenrir} to true
        else if {_id} is "song_dao":
            add 2.5 to {aov_bonus::%{_u}%::damage}
            add 25.0 to {aov_bonus::%{_u}%::crit_chance}
            add 7.0 to {aov_bonus::%{_u}%::speed}
            set {aov_bonus::%{_u}%::has_songdao} to true
        else if {_id} is "quy_kiem":
            add 5.0 to {aov_bonus::%{_u}%::damage}
            add 18.0 to {aov_bonus::%{_u}%::lifesteal}
            set {aov_bonus::%{_u}%::has_quykiem} to true
        else if {_id} is "thuong_xuyen_pha":
            add 5.0 to {aov_bonus::%{_u}%::damage}
            add 14.0 to {aov_bonus::%{_u}%::hp}
            add 20.0 to {aov_bonus::%{_u}%::def}
            add 15.0 to {aov_bonus::%{_u}%::armor_pen}
            set {aov_bonus::%{_u}%::has_xuyenpha} to true
        else if {_id} is "giap_thong_kho":
            add 24.0 to {aov_bonus::%{_u}%::hp}
            add 65.0 to {aov_bonus::%{_u}%::def}
            set {aov_bonus::%{_u}%::has_thongkho} to true
        else if {_id} is "khien_that_truyen":
            add 24.0 to {aov_bonus::%{_u}%::hp}
            add 70.0 to {aov_bonus::%{_u}%::def}
            set {aov_bonus::%{_u}%::has_thatruyen} to true
        else if {_id} is "giap_gaia":
            add 26.0 to {aov_bonus::%{_u}%::hp}
            add 50.0 to {aov_bonus::%{_u}%::def}
            add 5.0 to {aov_bonus::%{_u}%::speed}
            set {aov_bonus::%{_u}%::has_gaia} to true
        else if {_id} is "huan_chuong_troy":
            add 22.0 to {aov_bonus::%{_u}%::hp}
            add 60.0 to {aov_bonus::%{_u}%::def}
            add 10.0 to {aov_bonus::%{_u}%::cdr}
            set {aov_bonus::%{_u}%::has_troy} to true
        else if {_id} is "giap_ho_menh":
            add 2.0 to {aov_bonus::%{_u}%::damage}
            add 14.0 to {aov_bonus::%{_u}%::hp}
            add 40.0 to {aov_bonus::%{_u}%::def}
            set {aov_bonus::%{_u}%::has_homenh} to true
        else if {_id} is "phu_chu_truong_sinh":
            add 38.0 to {aov_bonus::%{_u}%::hp}
            add 30.0 to {aov_bonus::%{_u}%::def}
            add 12.0 to {aov_bonus::%{_u}%::heal_bonus}
            set {aov_bonus::%{_u}%::has_truongsinh} to true

    # Vô Quả Giả Nội tại: Tinh Thông Trang Bị Liên Quân (+15% AD, HP và DEF nếu không có Trái Ác Quỷ)
    set {_is_no_fruit} to false
    if {df_data::%{_u}%::fruit} is not set:
        set {_is_no_fruit} to true
    else if {df_data::%{_u}%::fruit} is "none" or "":
        set {_is_no_fruit} to true

    if {_is_no_fruit} is true:
        set {aov_bonus::%{_u}%::damage} to {aov_bonus::%{_u}%::damage} * 1.15
        set {aov_bonus::%{_u}%::hp} to {aov_bonus::%{_u}%::hp} * 1.15
        set {aov_bonus::%{_u}%::def} to {aov_bonus::%{_u}%::def} * 1.15

    # Giới hạn Trần CDR tối đa 40.0% (Phần vượt trần chuyển hóa thành sát thương kỹ năng)
    if {aov_bonus::%{_u}%::cdr} > 40.0:
        set {aov_bonus::%{_u}%::cdr_overflow} to {aov_bonus::%{_u}%::cdr} - 40.0
        set {aov_bonus::%{_u}%::cdr} to 40.0
    else:
        set {aov_bonus::%{_u}%::cdr_overflow} to 0.0

    set {aov_bonus::%{_u}%::damage} to roundOneDecimal({aov_bonus::%{_u}%::damage})
    set {aov_bonus::%{_u}%::ad} to {aov_bonus::%{_u}%::damage}
    set {aov_bonus::%{_u}%::crit_chance} to roundOneDecimal({aov_bonus::%{_u}%::crit_chance})
    set {aov_bonus::%{_u}%::crit_damage} to roundOneDecimal({aov_bonus::%{_u}%::crit_damage})
    set {aov_bonus::%{_u}%::armor_pen} to roundOneDecimal({aov_bonus::%{_u}%::armor_pen})
    set {aov_bonus::%{_u}%::lifesteal} to roundOneDecimal({aov_bonus::%{_u}%::lifesteal})
    set {aov_bonus::%{_u}%::hp} to roundOneDecimal({aov_bonus::%{_u}%::hp})
    set {aov_bonus::%{_u}%::def} to roundOneDecimal({aov_bonus::%{_u}%::def})
    set {aov_bonus::%{_u}%::cdr} to roundOneDecimal({aov_bonus::%{_u}%::cdr})
    set {aov_bonus::%{_u}%::speed} to roundOneDecimal({aov_bonus::%{_u}%::speed})

    loop integers from 1 to 6:
        set {aov_equip::%{_u}%::%loop-integer%} to {aov_slot::%{_u}%::%loop-integer%}

    set {card_bonus::%{_u}%::crit_chance} to {aov_bonus::%{_u}%::crit_chance}
    set {card_bonus::%{_u}%::crit_damage} to {aov_bonus::%{_u}%::crit_damage}
    set {card_bonus::%{_u}%::accuracy} to 0.0
    set {card_bonus::%{_u}%::dodge} to 0.0

    recalcPlayerMaxHealth({_p})

    set {_walk} to 0.2 * (1 + ({aov_bonus::%{_u}%::speed} / 100))
    if {_walk} > 1.0:
        set {_walk} to 1.0
    set walk speed of {_p} to {_walk}

function countEquippedAoV(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_max} to getMaxAoVSlots({_p})
    set {_cnt} to 0
    loop integers from 1 to {_max}:
        set {_id} to migrateAoVSlotToId({_u}, loop-integer)
        if {_id} is not "":
            add 1 to {_cnt}
    return {_cnt}

function hasAoVItemInTray(p: player, id: text) :: boolean:
    set {_u} to uuid of {_p}
    set {_max} to getMaxAoVSlots({_p})
    loop integers from 1 to {_max}:
        set {_equipped_id} to migrateAoVSlotToId({_u}, loop-integer)
        if {_equipped_id} is {_id}:
            return true
    return false

# ---------------------------------------------------------------------
# 4. GUI NÂNG CẤP THIÊN PHÚ (/thienphu) - ICON PHÁT SÁNG HIDEFLAGS:63
# ---------------------------------------------------------------------
command /thienphu:
    aliases: /talent
    trigger:
        openTalentUpgradeGUI(player)

function openTalentUpgradeGUI(p: player):
    set {_inv} to createStandardUI({_p}, "UI_G3_A", "&8✦ &6&lBẢNG THIÊN PHÚ & CHỈ SỐ &8✦", 6, orange stained glass pane named " ", "UI_G3", "Thiên Phú & Trang Bị")
    openStandardUI({_p}, {_inv}, "UI_G3_A", "UI_G3")
    refreshTalentUpgradeGUI({_p})

function refreshTalentUpgradeGUI(p: player):
    initTalentData({_p})
    recalcAoVBonuses({_p})
    set {_u} to uuid of {_p}

    set {_cc} to getTalentTotal({_p}, "crit_chance")
    set {_cd} to getTalentTotal({_p}, "crit_damage")
    set {_acc} to getTalentTotal({_p}, "accuracy")
    set {_dod} to getTalentTotal({_p}, "dodge")
    set {_equipped} to countEquippedAoV({_p})
    set {_max_slots} to getMaxAoVSlots({_p})
    set {_hp} to (max health of {_p}) * 2
    set {_atk} to ({aov_bonus::%{_u}%::damage} ? 0)
    set {_pen} to ({aov_bonus::%{_u}%::armor_pen} ? 0)
    set {_cdr} to ({aov_bonus::%{_u}%::cdr} ? 0)
    set {_ls} to ({aov_bonus::%{_u}%::lifesteal} ? 0)

    set {_cdrWarn} to ""
    if {_cdr} >= 40:
        set {_cdrWarn} to " &c&l(ĐẠT TRẦN CDR)"

    set {_h_lore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_h_lore::2} to "&8▪ &7Người Chơi: &e%name of {_p}%"
    set {_h_lore::3} to "&8▪ &7Điểm Thiên Phú: &6&l%{talent::%{_u}%::points}% Điểm &7(Đã cộng: &e%{talent::%{_u}%::spent}%&7)"
    set {_h_lore::4} to "&8▪ &7Khay Trang Bị: &d%{_equipped}%/%{_max_slots}% Món"
    set {_h_lore::5} to ""
    set {_h_lore::6} to "&6✦ BẢNG 9 CHỈ SỐ THỰC CHIẾN CỘNG DỒN ✦"
    set {_h_lore::7} to "&f❤ Máu Tối Đa (HP): &a%{_hp}% HP &8(%(round({_hp} / 2))% Tim)"
    set {_h_lore::8} to "&f⚔ Sát Thương AoV (ATK): &c+%{_atk}% ST"
    set {_h_lore::9} to "&f⚡ Tỷ Lệ Chí Mạng (CC): &e%{_cc}%%%"
    set {_h_lore::10} to "&f☠ Sát Thương CM (CD): &4%{_cd}%%%"
    set {_h_lore::11} to "&f⚓ Xuyên Giáp (PEN): &b%{_pen}%%%"
    set {_h_lore::12} to "&f✦ Né Tránh (DODGE): &a%{_dod}%%% &8(Né đòn kẻ địch, trần 70%%)"
    set {_h_lore::13} to "&f❖ Chính Xác (ACC): &b+%{_acc}%%% &8(Xuyên trừ Né kẻ địch)"
    set {_cdrText} to "%{_cdr}%%%"
    set {_h_lore::14} to "&f◷ Giảm Hồi Chiêu (CDR): &3%{_cdrText}%%{_cdrWarn}%"
    set {_h_lore::15} to "&f✪ Hút Máu (LS): &d%{_ls}%%%"
    set {_h_lore::16} to ""
    set {_h_lore::17} to "&e▸ Né Thực Chiến: &fmax(0, Né bạn - CX địch) &8(Trần 70%%)"
    set {_h_lore::18} to "&e▸ Khắc Chế Né: &fĐòn đánh của bạn giảm &b-%{_acc}%%% &fNé của đối thủ"
    set {_h_lore::19} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_pName} to name of {_p}
    set {_head} to makePlayerProfileHead({_p}, {_pName}, {_h_lore::*}, "&e&l✦ BẢNG 9 CHỈ SỐ THỰC CHIẾN ✦")
    set slot 4 of {_p}'s current inventory to {_head}

    set {_b_cc} to getTalentBase({_p}, "crit_chance")
    set {_a_cc} to ({aov_bonus::%{_u}%::crit_chance} ? 0)
    set {_cclore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_cclore::2} to "&7Gốc: &e%{_b_cc}%%% &8| &6AoV: +%{_a_cc}%%%"
    set {_cclore::3} to "&7Tổng hiện tại: &f%{_cc}%%%"
    set {_cclore::4} to "&7Mỗi điểm: &a+0.5%% &8| &7Giá: &61 Điểm TP"
    set {_cclore::5} to ""
    set {_cclore::6} to "&e▸ Chuột Trái: &fCộng 1 điểm"
    set {_cclore::7} to "&6▸ Chuột Phải / Shift: &fCộng 5 điểm"
    set {_cclore::8} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 19 of {_p}'s current inventory to makeGlowingItem(gold sword, "&c&lNÂNG CẤP: TỶ LỆ CHÍ MẠNG", {_cclore::*})

    set {_b_cd} to getTalentBase({_p}, "crit_damage")
    set {_a_cd} to ({aov_bonus::%{_u}%::crit_damage} ? 0)
    set {_cdlore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_cdlore::2} to "&7Gốc: &e%{_b_cd}%%% &8| &6AoV: +%{_a_cd}%%%"
    set {_cdlore::3} to "&7Tổng hiện tại: &f%{_cd}%%%"
    set {_cdlore::4} to "&7Mỗi điểm: &a+2.0%% &8| &7Giá: &61 Điểm TP"
    set {_cdlore::5} to ""
    set {_cdlore::6} to "&e▸ Chuột Trái: &fCộng 1 điểm"
    set {_cdlore::7} to "&6▸ Chuột Phải / Shift: &fCộng 5 điểm"
    set {_cdlore::8} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 21 of {_p}'s current inventory to makeGlowingItem(blaze powder, "&4&lNÂNG CẤP: SÁT THƯƠNG CHÍ MẠNG", {_cdlore::*})

    set {_b_acc} to getTalentBase({_p}, "accuracy")
    set {_acclore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_acclore::2} to "&7Gốc: &e+%{_b_acc}%%%"
    set {_acclore::3} to "&7Tổng hiện tại: &f+%{_acc}%%%"
    set {_acclore::4} to "&7Mỗi điểm: &a+1.0%% &8| &7Giá: &61 Điểm TP"
    set {_acclore::5} to "&7Công dụng: &bXuyên trừ %{_acc}%%% Né Tránh của địch"
    set {_acclore::6} to ""
    set {_acclore::7} to "&e▸ Chuột Trái: &fCộng 1 điểm"
    set {_acclore::8} to "&6▸ Chuột Phải / Shift: &fCộng 5 điểm"
    set {_acclore::9} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 23 of {_p}'s current inventory to makeGlowingItem(bow, "&b&lNÂNG CẤP: CHÍNH XÁC", {_acclore::*})

    set {_b_dod} to getTalentBase({_p}, "dodge")
