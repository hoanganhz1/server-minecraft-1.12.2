# =====================================================================
# HỆ THỐNG TRANG BỊ LIÊN QUÂN MOBILE & THIÊN PHÚ RPG (MINECRAFT 1.12.2)
# TECHNICAL GAME ARTIST & GAMEPLAY DEVELOPER — OPTIMIZED EDITION
# - Lưu trữ Slot bằng String ID (giảm 95% dung lượng DB, chống corrupt NBT)
# - Triệt tiêu hoàn toàn AssertionError tại AliasesMap.matchAlias (1.12.2)
# - Tối ưu hóa Vòng lặp Nội tại bằng System.currentTimeMillis()
# =====================================================================

import:
    java.lang.System
    org.bukkit.inventory.ItemStack
    org.bukkit.event.inventory.InventoryDragEvent

# ---------------------------------------------------------------------
# 1. HỆ THỐNG PHÂN QUYỀN Ô TRANG BỊ THEO RANK (3 -> 6 Ô) & MỞ KHÓA MASTERY/BOUNTY
# ---------------------------------------------------------------------
function getMaxAoVSlots(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_max} to 3
    set {_dfMastery} to ({df_data::%{_u}%::mastery} ? 0)
    set {_martialMastery} to ({martial_mastery::%{_u}%} ? 0)
    if {_dfMastery} >= 100:
        set {_max} to 4
    else if {_martialMastery} >= 100:
        set {_max} to 4
    if ({bounty::%{_u}%} ? 0) >= 100000000:
        if {_max} < 5:
            set {_max} to 5
    if {_p} has permission "rank.vip":
        if {_max} < 4:
            set {_max} to 4
    if {_p} has permission "rank.king":
        if {_max} < 5:
            set {_max} to 5
    if {_p} has permission "rank.master":
        set {_max} to 6
    return {_max}

function getMaxCardSlots(p: player) :: number:
    return getMaxAoVSlots({_p})

