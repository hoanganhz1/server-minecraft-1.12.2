    if hasAoVItemInTray({_p}, "thanh_kiem") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_tk}
    set slot 10 of {_p}'s current inventory to {_tk}

    set {_mura} to createAoVItem("muramasa")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6200 Coin" and "" and "&a▸ Nhấn để Rèn Muramasa!" to lore of {_mura}
    if hasAoVItemInTray({_p}, "muramasa") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_mura}
    set slot 11 of {_p}'s current inventory to {_mura}

    set {_fenrir} to createAoVItem("nanh_fenrir")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6280 Coin" and "" and "&a▸ Nhấn để Rèn Nanh Fenrir!" to lore of {_fenrir}
    if hasAoVItemInTray({_p}, "nanh_fenrir") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_fenrir}
    set slot 12 of {_p}'s current inventory to {_fenrir}

    set {_sd} to createAoVItem("song_dao")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6120 Coin" and "" and "&a▸ Nhấn để Rèn Song Đao Bão Táp!" to lore of {_sd}
    if hasAoVItemInTray({_p}, "song_dao") is true:
        add "&a✔ ĐANG LẮP TRONG KHAY" to lore of {_sd}
    set slot 13 of {_p}'s current inventory to {_sd}

    set {_qk} to createAoVItem("quy_kiem")
    add "" and "&6✦ CHI PHÍ CHẾ TẠO ✦" and "&f• Giá: &6200 Coin" and "" and "&a▸ Nhấn để Rèn Quỷ Kiếm!" to lore of {_qk}
    if hasAoVItemInTray({_p}, "quy_kiem") is true:
