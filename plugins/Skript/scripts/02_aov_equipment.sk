    set {_dodlore::2} to "&7Gốc: &e%{_b_dod}%%% &8(Tối đa 20%% từ TP)"
    set {_dodlore::3} to "&7Tổng hiện tại: &f%{_dod}%%%"
    set {_dodlore::4} to "&7Mỗi điểm: &a+0.4%% &8| &7Giá: &61 Điểm TP"
    set {_dodlore::5} to "&7Công dụng: &aNé đòn kẻ địch (bị giảm bởi CX địch, trần 70%%)"
    set {_dodlore::6} to ""
    set {_dodlore::7} to "&e▸ Chuột Trái: &fCộng 1 điểm"
    set {_dodlore::8} to "&6▸ Chuột Phải / Shift: &fCộng 5 điểm"
    set {_dodlore::9} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 25 of {_p}'s current inventory to makeGlowingItem(feather, "&a&lNÂNG CẤP: NÉ TRÁNH", {_dodlore::*})

    set {_resLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_resLore::2} to "&8▪ &7Phẩm chất: &6BẢO VẬT THẦN BÍ"
    set {_resLore::3} to "&f❖ Hoàn trả lại &e100%% Điểm Thiên Phú &fđã cộng."
    set {_resLore::4} to "&f❖ Đưa toàn bộ 4 nhánh chỉ số về mức ban đầu."
    set {_resLore::5} to ""
    set {_resLore::6} to "&7Giá mua nhanh: &630 Coin &8(hoặc đổi tại /nganhang)"
    set {_resLore::7} to ""
    set {_resLore::8} to "&e▸ Chuột Trái: &fDùng 1 Quả Cầu có sẵn trong túi"
    set {_resLore::9} to "&b▸ Chuột Phải: &fMua & Tẩy ngay (&630 Coin&f)"
    set {_resLore::10} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 30 of {_p}'s current inventory to makeCustomRPItem("talent_reset", "&6&l✦ QUẢ CẦU TẨY THIÊN PHÚ ✦", {_resLore::*})

    set {_ghLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_ghLore::2} to "&7Ghép 3 thẻ cùng bậc thành thẻ bậc cao hơn."
    set {_ghLore::3} to "&7Mở rộng sức mạnh tiềm năng chỉ số RPG."
    set {_ghLore::4} to ""
    set {_ghLore::5} to "&e▸ Nhấp để mở Bàn Ghép Thẻ (/ghepthe)!"
    set {_ghLore::6} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 32 of {_p}'s current inventory to makeGlowingItem(crafting table, "&e&l✦ BÀN GHÉP THẺ THIÊN PHÚ ✦", {_ghLore::*})

on inventory click:
    set {_u} to uuid of player
    if {ui_active::%{_u}%} is not "UI_G3_A":
        stop
    cancel event
    if clicked inventory is not player's current inventory:
        stop

    set {_times} to 1
    if event.isRightClick() is true:
        set {_times} to 5
    if event.isShiftClick() is true:
        set {_times} to 5

    set {_slot} to index of event-slot
    if {_slot} is 19:
        upgradeTalentStat(player, "crit_chance", {_times})
        refreshTalentUpgradeGUI(player)
    else if {_slot} is 21:
        upgradeTalentStat(player, "crit_damage", {_times})
        refreshTalentUpgradeGUI(player)
    else if {_slot} is 23:
        upgradeTalentStat(player, "accuracy", {_times})
        refreshTalentUpgradeGUI(player)
    else if {_slot} is 25:
        upgradeTalentStat(player, "dodge", {_times})
        refreshTalentUpgradeGUI(player)
    else if {_slot} is 30:
        set {_u} to uuid of player
        if ({talent::%{_u}%::spent} ? 0) <= 0:
            sendSystemMsg(player, "error", "Bạn chưa cộng điểm Thiên Phú nào để tẩy!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
            stop
        if event.isLeftClick() is true:
            if countPlayerItemByTag(player, "talent_reset") > 0:
                removePlayerItemByTag(player, "talent_reset", 1)
                resetTalentPoints(player)
                sendSystemMsg(player, "talent", "Đã dùng 1 Quả Cầu Tẩy Điểm và hoàn lại 100%% điểm!")
                play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to player
                refreshTalentUpgradeGUI(player)
            else:
                sendSystemMsg(player, "error", "Bạn không có Quả Cầu Tẩy Điểm trong túi! Chuột Phải để mua ngay ($50,000).")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
        else if event.isRightClick() is true:
            if getCoinBalance(player) >= 30:
                takeCoinBalance(player, 30)
                resetTalentPoints(player)
                sendSystemMsg(player, "talent", "Đã thanh toán 30 Coin tẩy điểm Thiên Phú thành công!")
                play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to player
                refreshTalentUpgradeGUI(player)
            else:
                sendSystemMsg(player, "error", "Bạn thiếu Coin! Cần 30 Coin để tẩy điểm (Đổi tại /nganhang).")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
    else if {_slot} is 32:
        wait 1 tick
        openAoVShopGUI(player)

command /trangbilq:
    aliases: /build, /aov, /khaythe
    trigger:
        openAoVTrayGUI(player)

function openAoVTrayGUI(p: player):
    set {_inv} to createStandardUI({_p}, "UI_G3_B", "&8✦ &6&lKHAY TRANG BỊ LIÊN QUÂN &8✦", 4, orange stained glass pane named " ", "UI_G3", "Thiên Phú & Trang Bị")
    openStandardUI({_p}, {_inv}, "UI_G3_B", "UI_G3")
    refreshAoVTrayGUI({_p})

function refreshAoVTrayGUI(p: player):
    initTalentData({_p})
    recalcAoVBonuses({_p})
    set {_u} to uuid of {_p}
    set {_max_slots} to getMaxAoVSlots({_p})
    set {_equipped} to countEquippedAoV({_p})

    set {_b::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_b::2} to "&8▪ &7Ô trang bị đã dùng: &e%{_equipped}%/%{_max_slots}% Ô"
    set {_b::3} to ""
    set {_b::4} to "&c⚔ Sát Thương Gốc: &f+%{aov_bonus::%{_u}%::damage}% ST"
    set {_b::5} to "&e⚔ Tỷ Lệ Chí Mạng: &f+%{aov_bonus::%{_u}%::crit_chance}%%%"
    set {_b::6} to "&4⚔ ST Chí Mạng: &f+%{aov_bonus::%{_u}%::crit_damage}%%%"
    set {_b::7} to "&b⚔ Xuyên Giáp: &f+%{aov_bonus::%{_u}%::armor_pen}%%%"
    set {_b::8} to "&d✦ Hút Máu: &f+%{aov_bonus::%{_u}%::lifesteal}%%%"
    set {_b::9} to "&a❤ Máu Tối Đa: &f+%{aov_bonus::%{_u}%::hp}% HP &8(+%(round({aov_bonus::%{_u}%::hp} / 2))% Tim)"
    set {_b::10} to "&9❖ Giáp Điểm (DEF): &f+%{aov_bonus::%{_u}%::def}% DEF"
    set {_b::11} to "&3◷ Giảm Hồi Chiêu: &f+%{aov_bonus::%{_u}%::cdr}%%%"
    set {_b::12} to "&f✦ Tốc Độ Chạy: &f+%{aov_bonus::%{_u}%::speed}%%%"
    set {_b::13} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 4 of {_p}'s current inventory to makeGlowingItem(book, "&6&l✦ CHỈ SỐ TRANG BỊ LIÊN QUÂN ✦", {_b::*})

    # 6 Ô Trang bị: 3 Ô mặc định (11, 13, 15) + 3 Ô Rank (20, 22, 24)
    # Ánh xạ index 1..6
    set {_slot_map::1} to 11
    set {_slot_map::2} to 13
    set {_slot_map::3} to 15
    set {_slot_map::4} to 20
    set {_slot_map::5} to 22
    set {_slot_map::6} to 24

    loop integers from 1 to 6:
        set {_rawSlot} to {_slot_map::%loop-integer%}
        if loop-integer <= {_max_slots}:
            set {_eqId} to migrateAoVSlotToId({_u}, loop-integer)
            if {_eqId} is not "":
                set {_disp} to createAoVItem({_eqId})
                add "" and "&c▸ Nhấn để tháo Trang Bị về túi đồ!" to lore of {_disp}
                set slot {_rawSlot} of {_p}'s current inventory to {_disp}
            else:
                set slot {_rawSlot} of {_p}'s current inventory to yellow stained glass pane named "&e&l[Ô TRANG BỊ SỐ %loop-integer% - TRỐNG]" with lore ("&7Nhấn vào một &6Trang Bị Liên Quân &7trong" and "&7túi đồ của bạn để lắp vào ô này." and "" and "&e▸ Lưu ý: Không lắp 2 món cùng loại!")
        else:
            if loop-integer is 4:
                set {_req} to "&b&lVIP"
            else if loop-integer is 5:
                set {_req} to "&d&lKING"
            else:
                set {_req} to "&6&lMASTER"
            set slot {_rawSlot} of {_p}'s current inventory to red stained glass pane named "&c&l[Ô TRANG BỊ SỐ %loop-integer% - ĐÃ KHÓA]" with lore ("&7Yêu cầu nâng cấp Rank %{_req}%" and "&7tại &e/coinshop &7để mở khóa ô này!" and "" and "&c✖ Chưa đủ điều kiện mở khóa")

on inventory click:
    set {_u} to uuid of player
    if {ui_active::%{_u}%} is not "UI_G3_B":
        stop
    cancel event
    set {_max_slots} to getMaxAoVSlots(player)

    # 1. Nhấn vào túi đồ cá nhân để LẮP TRANG BỊ
    if clicked inventory is player's inventory:
        set {_rawItem} to event.getCurrentItem()
        if {_rawItem} is not set:
            stop
        if {_rawItem} is air:
            stop
        if type of {_rawItem} is air:
            stop
        if {_rawItem} is an instance of ItemStack:
            if {_rawItem}.getAmount() <= 0:
                stop

        set {_id} to getAoVItemId({_rawItem})
        if {_id} is "":
            sendSystemMsg(player, "error", "Vật phẩm này không phải là Trang Bị Liên Quân hợp lệ!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
            stop

        if hasAoVItemInTray(player, {_id}) is true:
            set {_dupName} to getAoVItemName({_id})
            sendSystemMsg(player, "error", "Bạn đã trang bị %{_dupName}% &crồi! Mỗi món chỉ được lắp 1 lần duy nhất.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
            stop

        set {_free_idx} to 0
        loop integers from 1 to {_max_slots}:
            set {_checkId} to migrateAoVSlotToId({_u}, loop-integer)
            if {_checkId} is "":
                set {_free_idx} to loop-integer
                stop loop

        if {_free_idx} is 0:
            sendSystemMsg(player, "error", "Tất cả các ô trang bị đã mở khóa (%{_max_slots}%/%{_max_slots}%) đều đã đầy!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
            stop

        set {_amt} to {_rawItem}.getAmount()
        if {_amt} <= 1:
            set clicked slot to air
        else:
            set item amount of clicked slot to ({_amt} - 1)

        set {aov_slot::%{_u}%::%{_free_idx}%} to {_id}
        recalcAoVBonuses(player)
        set {_eqName} to getAoVItemName({_id})
        sendSystemMsg(player, "combat", "Đã lắp %{_eqName}% &fvào ô số &e%{_free_idx}%&f!")
        play sound "ENTITY_EXPERIENCE_ORB_PICKUP" with volume 1 and pitch 1.2 to player
        refreshAoVTrayGUI(player)
        stop

    # 2. Thao tác trên GUI Khay Trang Bị
    if clicked inventory is not player's current inventory:
        stop
    set {_slot} to index of event-slot

    set {_slot_idx} to 0
    if {_slot} is 11:
        set {_slot_idx} to 1
    else if {_slot} is 13:
        set {_slot_idx} to 2
    else if {_slot} is 15:
        set {_slot_idx} to 3
    else if {_slot} is 20:
        set {_slot_idx} to 4
    else if {_slot} is 22:
        set {_slot_idx} to 5
    else if {_slot} is 24:
        set {_slot_idx} to 6

    if {_slot_idx} > 0:
        if {_slot_idx} <= {_max_slots}:
            set {_curId} to migrateAoVSlotToId({_u}, {_slot_idx})
            if {_curId} is not "":
                set {_returnItem} to createAoVItem({_curId})
                if player cannot hold {_returnItem}:
                    sendSystemMsg(player, "error", "Túi đồ của bạn đã đầy! Hãy dọn chỗ trống trước khi tháo trang bị.")
                    play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
                    stop
                delete {aov_slot::%{_u}%::%{_slot_idx}%}
                give {_returnItem} to player
                recalcAoVBonuses(player)
                set {_unequipName} to getAoVItemName({_curId})
                sendSystemMsg(player, "combat", "Đã tháo %{_unequipName}% &fvề túi đồ!")
                play sound "ENTITY_EXPERIENCE_ORB_PICKUP" with volume 1 and pitch 0.9 to player
                refreshAoVTrayGUI(player)
        else:
            sendSystemMsg(player, "error", "Ô trang bị số &e%{_slot_idx}% &cđang bị khóa! Nâng cấp Rank tại &e/coinshop &cđể mở khóa.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player

command /shopaov:
    aliases: /repaov, /aovshop
    trigger:
        openAoVShopGUI(player)

function openAoVShopGUI(p: player):
    set {_inv} to createStandardUI({_p}, "UI_G3_C", "&8✦ &6&lXƯỞNG RÈN TRANG BỊ LIÊN QUÂN &8✦", 6, orange stained glass pane named " ", "UI_G3", "Thiên Phú & Trang Bị")
    openStandardUI({_p}, {_inv}, "UI_G3_C", "UI_G3")
    refreshAoVShopGUI({_p})

function getAoVCoinPrice(id: text) :: number:
    if {_id} is "thanh_kiem" or "muramasa" or "quy_kiem" or "giap_gaia" or "huan_chuong_troy":
        return 200
    else if {_id} is "nanh_fenrir":
        return 280
    else if {_id} is "giap_ho_menh":
        return 350
    else if {_id} is "phu_chu_truong_sinh":
        return 300
    else if {_id} is "song_dao" or "thuong_xuyen_pha" or "giap_thong_kho" or "khien_that_truyen":
        return 120
    return 0

function refreshAoVShopGUI(p: player):
    # Slot 4: Mua Rương Trang Bị Liên Quân
    delete {_chestLore::*}
    set {_chestLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_chestLore::2} to "&8▪ &7Vật phẩm: &6&lRƯƠNG TRANG BỊ AOV"
    set {_chestLore::3} to "&fMở ngẫu nhiên 1 trong 12 Trang Bị Cực Phẩm."
    set {_chestLore::4} to ""
    set {_chestLore::5} to "&e✦ CHI PHÍ MUA RƯƠNG:"
    set {_chestLore::6} to "&f• Giá: &6160 Coin &8(Đổi tại /nganhang)"
    set {_chestLore::7} to ""
    set {_chestLore::8} to "&a▸ Click: &fMua Rương Trang Bị AoV!"
    set {_chestLore::9} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_chestItem} to makeCustomRPItem("aov_chest", "&6&l✦ MUA RƯƠNG TRANG BỊ AOV ✦", {_chestLore::*})
    set slot 4 of {_p}'s current inventory to {_chestItem}

    set slot 9 of {_p}'s current inventory to book named "&c&lNHÓM CÔNG VẬT LÝ" with lore ("&76 Trang Bị Tấn Công uy lực" and "&7tăng Sát thương, Chí mạng, Xuyên giáp...")

