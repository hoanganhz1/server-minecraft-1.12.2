# ---------------------------------------------------------------------
# 1. HÀM ĐỊNH DẠNG SỨC MẠNH & TRA CỨU BẬC TIẾN HÓA
# ---------------------------------------------------------------------

function formatDisciplePower(n: number) :: text:
    if {_n} is not set:
        return "0"
    if {_n} < 1000:
        return "%round({_n})%"
    if {_n} < 1000000:
        return "%round({_n} / 1000)% K"
    if {_n} < 1000000000:
        return "%round({_n} / 1000000)% Tr"
    set {_val} to (round({_n} / 10000000)) / 100
    return "%{_val}% Tỷ"

function getDiscipleTier(power: number) :: number:
    if {_power} < 150000000:
        return 1
    else if {_power} < 1500000000:
        return 2
    return 3

function getDiscipleTierName(tier: number) :: text:
    if {_tier} is 1:
        return "&fSkeleton Cấp 1"
    else if {_tier} is 2:
        return "&8Wither Skeleton Cấp 2"
    return "&cKỵ Binh Xương Cấp 3"

# ---------------------------------------------------------------------
# 2. HÀM QUẢN LÝ BÙA ĐỆ TỬ & COIN (PLAYERPOINTS)
# ---------------------------------------------------------------------

function getPlayerPointsBal(p: player) :: number:
    set {_pp} to PlayerPoints.getInstance()
    if {_pp} is not set:
        return 0
    return {_pp}.getAPI().look({_p}.getUniqueId())

function takePlayerPoints(p: player, amt: number) :: boolean:
    set {_pp} to PlayerPoints.getInstance()
    if {_pp} is not set:
        return false
    set {_api} to {_pp}.getAPI()
    set {_uuid} to {_p}.getUniqueId()
    set {_bal} to {_api}.look({_uuid})
    if {_bal} < {_amt}:
        return false
    return {_api}.take({_uuid}, {_amt})

function isCharmActive(u: text, charm: text) :: boolean:
    set {_nowSec} to System.currentTimeMillis() / 1000
    if {disciple_charm::%{_u}%::%{_charm}%} is set:
        if {disciple_charm::%{_u}%::%{_charm}%} > {_nowSec}:
            return true
    return false

function getCharmRemainingText(u: text, charm: text) :: text:
    set {_nowSec} to System.currentTimeMillis() / 1000
    set {_expSec} to {disciple_charm::%{_u}%::%{_charm}%} ? 0
    if {_expSec} <= {_nowSec}:
        return "&cChưa kích hoạt"
    set {_rem} to round({_expSec} - {_nowSec})
    set {_hours} to floor({_rem} / 3600)
    set {_mVal} to {_rem} - ({_hours} * 3600)
    set {_mins} to floor({_mVal} / 60)
    return "&aCòn %{_hours}%h %{_mins}%m"

function createCharmGUIItem(name: text, desc: text, timeRem: text) :: item:
    set {_it} to ("paper" parsed as item)
    set name of {_it} to colored {_name}
    delete {_lore::*}
    set {_lore::1} to "&8&m--------------------------------"
    set {_lore::2} to "&7Tác dụng: &f%{_desc}%"
    set {_lore::3} to "&7Thời hạn: %{_timeRem}%"
    set {_lore::4} to ""
    set {_lore::5} to "&e▶ Nhấp để gia hạn thêm 24 Giờ"
    set {_lore::6} to "&8&m--------------------------------"
    set lore of {_it} to {_lore::*}
    return {_it}

function addDiscipleCharmDuration(u: text, charm: text, sec: number):
    set {_nowSec} to System.currentTimeMillis() / 1000
    set {_cur} to {disciple_charm::%{_u}%::%{_charm}%} ? 0
    if {_cur} < {_nowSec}:
        set {_cur} to {_nowSec}
    set {disciple_charm::%{_u}%::%{_charm}%} to {_cur} + {_sec}

# ---------------------------------------------------------------------
# 3. HỆ THỐNG TRANG BỊ & CHỈ SỐ ĐỆ TỬ (STRING ID ONLY)
# ---------------------------------------------------------------------

function countDiscipleSetPieces(p: player, setId: text) :: number:
    set {_u} to uuid of {_p}
    set {_cnt} to 0
    if {disciple_equip::%{_u}%::helmet} is "%{_setId}%_helmet":
        add 1 to {_cnt}
    if {disciple_equip::%{_u}%::chest} is "%{_setId}%_chest":
        add 1 to {_cnt}
    if {disciple_equip::%{_u}%::legs} is "%{_setId}%_legs":
        add 1 to {_cnt}
    if {disciple_equip::%{_u}%::boots} is "%{_setId}%_boots":
        add 1 to {_cnt}
    return {_cnt}

function getDiscipleSetBonus(p: player) :: text:
    set {_u} to uuid of {_p}
    set {_h} to {disciple_equip::%{_u}%::helmet} ? ""
    set {_c} to {disciple_equip::%{_u}%::chest} ? ""
    set {_l} to {disciple_equip::%{_u}%::legs} ? ""
    set {_b} to {disciple_equip::%{_u}%::boots} ? ""
    if {_h} is "set1_helmet":
        if {_c} is "set1_chest":
            if {_l} is "set1_legs":
                if {_b} is "set1_boots":
                    return "set1"
    if {_h} is "set2_helmet":
        if {_c} is "set2_chest":
            if {_l} is "set2_legs":
                if {_b} is "set2_boots":
                    return "set2"
    if {_h} is "set3_helmet":
        if {_c} is "set3_chest":
            if {_l} is "set3_legs":
                if {_b} is "set3_boots":
                    return "set3"
    return "none"

