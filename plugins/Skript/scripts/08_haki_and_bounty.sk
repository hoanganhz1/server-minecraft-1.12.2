# =====================================================================
# HỆ THỐNG HAKI & TIỀN TRUY NÃ ONE PIECE (PAPER 1.12.2 - SKRIPT 2.6.4 + REFLECT)
# STUDIO MASTER SPECIFICATION — CHẶNG 4 (08_haki_and_bounty.sk)
# 1. GUI /haki: Haki Quan Sát, Haki Vũ Trang (khắc chế Logia), Haki Bá Vương
#    Kết nối trực tiếp vào hệ thống Thiên Phú (dodge, accuracy, crit_damage)
# 2. Hệ thống Tiền Truy Nã /truyna (/bounty) bằng Đầu 3D Wanted Poster
#    Tăng Beri khi diệt Boss (+5M) và diệt PvP (+10M), săn nhận Money + TP
# =====================================================================

import:
    org.black_ixx.playerpoints.PlayerPoints
    java.lang.System
    java.util.UUID
    java.nio.charset.StandardCharsets
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.Particle
    org.bukkit.Location
    org.bukkit.util.Vector
    org.bukkit.entity.Player
    org.bukkit.entity.LivingEntity
    org.bukkit.entity.Monster
    org.bukkit.entity.Entity
