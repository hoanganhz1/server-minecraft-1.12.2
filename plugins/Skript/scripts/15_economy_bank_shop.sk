# =====================================================================
# HỆ THỐNG KINH TẾ TRUNG TÂM: NGÂN HÀNG, /shop & /cshop (PHASE 15)
# Paper 1.12.2 / Skript 2.6.4 / Vault (Money) & PlayerPoints (Coin)
# Tỷ giá niêm yết cứng: $10,000 Money = 1 Coin (Khóa chống lạm phát)
# =====================================================================

import:
    org.bukkit.event.inventory.InventoryDragEvent

options:
    exchange_rate: 10000
    bank_buy_coin_fee_pct: 0

# =====================================================================
# PHẦN 1: HÀM MỞ GIAO DIỆN NGÂN HÀNG QUY ĐỔI (UI_BANK - 36 Ô)
# =====================================================================

function openBankExchangeGUI(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_pBal} to {_p}'s balance
    set {_balStr} to routerFormatNumber({_pBal})
    set {_coinBal} to getCoinBalance({_p})
    set {_coinStr} to routerFormatNumber({_coinBal})

    set {_retUI} to {ui_bank_return::%{_u}%} ? "UI_ROOT"
    set {_retName} to "Menu Tổng"
    if {_retUI} is "UI_SHOP":
        set {_retName} to "Siêu Thị /shop"
    else if {_retUI} is "UI_CSHOP":
        set {_retName} to "Cửa Hàng /cshop"
    else if {_retUI} is "UI_G6_C":
        set {_retName} to "Giao Thương G6"

    set {_inv} to createStandardUI({_p}, "UI_BANK", "&8✦ &6&lNGÂN HÀNG QUY ĐỔI TIỀN TỆ &8✦", 4, green stained glass pane named " ", {_retUI}, {_retName})

    # Slot 4: Sổ Tiết Kiệm (Đầu Người Chơi)
    set {_pName} to name of {_p}
    delete {_headLore::*}
    set {_headLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_headLore::2} to "&8▪ &7Chủ Tài Khoản: &e%{_pName}%"
    set {_headLore::3} to "&8▪ &7Tỷ Giá Cố Định: &a$10,000 &f= &61 Coin"
    set {_headLore::4} to ""
    set {_headLore::5} to "&6✦ SỐ DƯ TÀI KHOẢN ✦"
    set {_headLore::6} to "&f • &7Tiền Mặt (Vault): &a$%{_balStr}%"
    set {_headLore::7} to "&f • &7Coin Sức Mạnh (Points): &6%{_coinStr}% Coin"
    set {_headLore::8} to ""
    set {_headLore::9} to "&e▸ Đổi Money sang Coin để mua Trang Bị RPG & Danh Kiếm!"
    set {_headLore::10} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 4 of {_inv} to makePlayerProfileHead({_p}, {_pName}, {_headLore::*}, "&6&l✦ SỔ TIẾT KIỆM HẢI TẶC ✦")

    # Hàng 2 (Slots 10..14): Đổi Money -> Coin
    set slot 10 of {_inv} to makeGlowingItem(gold ingot, "&a&l✦ MUA 1 COIN &8[&a$10,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &a$10,000 Money" and "&7Nhận được: &6+1 Coin" and "" and "&a▸ Nhấp để Đổi 1 Coin!"))
    set slot 11 of {_inv} to makeGlowingItem(gold ingot, "&a&l✦ MUA 10 COIN &8[&a$100,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &a$100,000 Money" and "&7Nhận được: &6+10 Coin" and "" and "&a▸ Nhấp để Đổi 10 Coin!"))
    set slot 12 of {_inv} to makeGlowingItem(gold ingot, "&a&l✦ MUA 50 COIN &8[&a$500,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &a$500,000 Money" and "&7Nhận được: &6+50 Coin" and "" and "&a▸ Nhấp để Đổi 50 Coin!"))
    set slot 13 of {_inv} to makeGlowingItem(gold ingot, "&a&l✦ MUA 100 COIN &8[&a$1,000,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &a$1,000,000 Money" and "&7Nhận được: &6+100 Coin" and "" and "&a▸ Nhấp để Đổi 100 Coin!"))

    set {_maxBuyCoins} to floor({_pBal} / {@exchange_rate})
    set slot 14 of {_inv} to makeGlowingItem(gold block, "&e&l✦ ĐỔI TẤT CẢ MONEY ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Quy đổi tối đa với số tiền bạn có:" and "&f • &7Ước tính nhận: &6+%{_maxBuyCoins}% Coin" and "&f • &7Tiêu tốn: &a$%routerFormatNumber({_maxBuyCoins} * {@exchange_rate})%" and "" and "&e▸ Nhấp để Đổi Toàn Bộ!"))

    # Slot 16: Lối tắt Cửa Hàng Coin (/cshop)
    set slot 16 of {_inv} to makeGlowingItem(diamond, "&b&l✦ CỬA HÀNG COIN (/cshop) ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Dùng Coin mua Bảo Vật Ác Quỷ, Rank VIP" and "&7và mở khóa Trang Bị RPG tối thượng!" and "" and "&b▸ Nhấp để mở /cshop"))

    # Hàng 3 (Slots 19..23): Rút Coin -> Money
    set slot 19 of {_inv} to makeGlowingItem(paper, "&c&l✦ RÚT 1 COIN &8[&a+$10,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &61 Coin" and "&7Nhận lại: &a+$10,000 Money" and "" and "&c▸ Nhấp để Rút $10,000!"))
    set slot 20 of {_inv} to makeGlowingItem(paper, "&c&l✦ RÚT 10 COIN &8[&a+$100,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &610 Coin" and "&7Nhận lại: &a+$100,000 Money" and "" and "&c▸ Nhấp để Rút $100,000!"))
    set slot 21 of {_inv} to makeGlowingItem(paper, "&c&l✦ RÚT 50 COIN &8[&a+$500,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &650 Coin" and "&7Nhận lại: &a+$500,000 Money" and "" and "&c▸ Nhấp để Rút $500,000!"))
    set slot 22 of {_inv} to makeGlowingItem(paper, "&c&l✦ RÚT 100 COIN &8[&a+$1,000,000&8] ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Chi phí: &6100 Coin" and "&7Nhận lại: &a+$1,000,000 Money" and "" and "&c▸ Nhấp để Rút $1,000,000!"))

    set slot 23 of {_inv} to makeGlowingItem(iron block, "&6&l✦ RÚT TOÀN BỘ COIN ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Đổi toàn bộ Coin thành Money mặt:" and "&f • &7Ước tính nhận: &a+$%routerFormatNumber({_coinBal} * {@exchange_rate})%" and "&f • &7Tiêu tốn: &6%{_coinStr}% Coin" and "" and "&6▸ Nhấp để Rút Toàn Bộ!"))

    # Slot 25: Lối tắt Siêu Thị Tài Nguyên (/shop)
    set slot 25 of {_inv} to makeGlowingItem(chest, "&a&l✦ SIÊU THỊ SKYBLOCK (/shop) ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Dùng Money mặt mua sắm nông sản, quặng," and "&7vật liệu căn cứ và Spawner đảo!" and "" and "&a▸ Nhấp để mở /shop"))

    # Slot 31: Quy Tắc Tỷ Giá
    delete {_rLore::*}
    set {_rLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_rLore::2} to "&8▪ &7Tỷ giá trao đổi chính thức: &a$10,000 = 1 Coin"
    set {_rLore::3} to "&8▪ &7Ngân hàng đảm bảo thanh khoản 100%% không mất phí."
    set {_rLore::4} to "&8▪ &7Mọi giao dịch nạp / rút đều cộng trực tiếp số dư."
    set {_rLore::5} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set slot 31 of {_inv} to book named "&e&l✦ QUY CHUẨN TỶ GIÁ TIỀN TỆ ✦" with lore {_rLore::*}

    openStandardUI({_p}, {_inv}, "UI_BANK", {_retUI})

# =====================================================================
# PHẦN 2: SIÊU THỊ TÀI NGUYÊN SKYBLOCK (/shop - 100% MONEY)
# =====================================================================

function openResourceShopHubGUI(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_pBal} to {_p}'s balance
    set {_balStr} to routerFormatNumber({_pBal})

    set {_inv} to createStandardUI({_p}, "UI_SHOP", "&8✦ &2&lĐẠI SIÊU THỊ TÀI NGUYÊN SKYBLOCK &8✦", 4, green stained glass pane named " ", "UI_G6_C", "Trung Tâm Giao Thương")

    # Slot 4: Ví Tiền Mặt & Đặc Quyền Multiplier
    delete {_vLore::*}
    set {_vLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_vLore::2} to "&8▪ &7Tiền Mặt Hiện Có: &a$%{_balStr}%"
    set {_vLore::3} to ""
    set {_vLore::4} to "&6✦ ĐẶC QUYỀN GIÁ BÁN (/sellgui) ✦"
    set {_vLore::5} to "&f • &7Mặc Định: &e+0%% Multiplier"
    set {_vLore::6} to "&f • &bRank VIP: &a+5%% Giá Bán"
    set {_vLore::7} to "&f • &eRank KING: &a+10%% Giá Bán"
    set {_vLore::8} to "&f • &dRank MASTER: &a+20%% Giá Bán"
    set {_vLore::9} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_pName} to name of {_p}
    set slot 4 of {_inv} to makePlayerProfileHead({_p}, {_pName}, {_vLore::*}, "&a&l✦ VÍ TIỀN MẶT & ĐẶC QUYỀN ✦")

    # Slot 10: Gian Hàng 1 - Khối Xây Dựng
    set slot 10 of {_inv} to makeGlowingItem(grass, "&a&l✦ GIAN 1: KHỐI XÂY DỰNG ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Đá, đất, gỗ, kính, thạch anh, hắc diện thạch..." and "" and "&a▸ Nhấn để mở gian hàng!"))

    # Slot 11: Gian Hàng 2 - Nông Sản & Trứng Thú
    set slot 11 of {_inv} to makeGlowingItem(wheat, "&e&l✦ GIAN 2: NÔNG SẢN & THÚ NUÔI ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Hạt giống, củ quả, mía, xô nước, trứng gia súc..." and "" and "&e▸ Nhấn để mở gian hàng!"))

    # Slot 12: Gian Hàng 3 - Khoáng Sản & Giả Kim
    set slot 12 of {_inv} to makeGlowingItem(diamond, "&b&l✦ GIAN 3: KHOÁNG SẢN & GIẢ KIM ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Than, sắt, vàng, kim cương, ngọc lục bảo, totem..." and "" and "&b▸ Nhấn để mở gian hàng!"))

    # Slot 14: Gian Hàng 4 - Khối Uy Danh & Spawners
    set slot 14 of {_inv} to makeGlowingItem(beacon, "&d&l✦ GIAN 4: UY DANH & SPAWNERS ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Khối kim cương, beacon, lồng quái sinh sản..." and "" and "&d▸ Nhấn để mở gian hàng!"))

    # Slot 16: Bán Nhanh (/sellgui)
    set slot 16 of {_inv} to makeGlowingItem(gold ingot, "&6&l✦ BÁN NHANH VẬT PHẨM (/sellgui) ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Mở rương gom đồ tự động bán lấy Money." and "" and "&6▸ Nhấp để Bán Nhanh (/sellgui)"))

    # Slot 22: Vào Ngân Hàng Quy Đổi
    set slot 22 of {_inv} to makeGlowingItem(emerald, "&e&l✦ NGÂN HÀNG QUY ĐỔI COIN ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Đổi Money sang Coin để mua Trang Bị RPG." and "" and "&e▸ Nhấp để vào Ngân Hàng"))

    openStandardUI({_p}, {_inv}, "UI_SHOP", "UI_G6_C")

function openResourceShopCategoryGUI(p: player, cat: number):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_pBal} to {_p}'s balance

    if {_cat} is 1:
        # Khối Xây Dựng (54 ô)
        set {_inv} to createStandardUI({_p}, "UI_SHOP_1", "&8✦ &2&lKHỐI XÂY DỰNG CĂN CỨ &8✦", 6, grass named " ", "UI_SHOP", "Siêu Thị /shop")
        # 12 Mặt hàng
        # Format: slot, item phôi, giá x16, giá x64
        setupShopItem({_inv}, 10, cobblestone, "Đá Cuội", 800, 3200, 16, 64)
        setupShopItem({_inv}, 11, stone, "Đá Mịn", 1200, 4800, 16, 64)
        setupShopItem({_inv}, 12, oak wood plank, "Gỗ Sồi", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 13, birch wood plank, "Gỗ Bạch Dương", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 14, spruce wood plank, "Gỗ Vân Sam", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 15, dirt, "Khối Đất", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 16, grass, "Khối Cỏ", 3200, 12800, 16, 64)
        setupShopItem({_inv}, 19, sand, "Khối Cát", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 20, glass, "Kính Trong Suốt", 2400, 9600, 16, 64)
        setupShopItem({_inv}, 21, quartz block, "Đá Thạch Anh", 6400, 25600, 16, 64)
        setupShopItem({_inv}, 22, sea lantern, "Đèn Biển", 8000, 32000, 16, 64)
        setupShopItem({_inv}, 23, obsidian, "Hắc Diện Thạch", 16000, 64000, 16, 64)
        openStandardUI({_p}, {_inv}, "UI_SHOP_1", "UI_SHOP")

    else if {_cat} is 2:
        # Nông Sản & Trứng Thú (54 ô)
        set {_inv} to createStandardUI({_p}, "UI_SHOP_2", "&8✦ &e&lNÔNG SẢN & THÚ NUÔI SKYBLOCK &8✦", 6, wheat named " ", "UI_SHOP", "Siêu Thị /shop")
        setupShopItem({_inv}, 10, wheat seeds, "Hạt Lúa Giống", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 11, carrot, "Cà Rốt", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 12, potato, "Khoai Tây", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 13, pumpkin seeds, "Hạt Bí Ngô", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 14, melon seeds, "Hạt Dưa Hấu", 1600, 6400, 16, 64)
        setupShopItem({_inv}, 15, sugar canes, "Cây Mía Đường", 3200, 12800, 16, 64)
        setupShopItem({_inv}, 16, cactus, "Xương Rồng", 3200, 12800, 16, 64)
        setupShopItem({_inv}, 19, nether wart, "Bướu Địa Ngục", 3200, 12800, 16, 64)
        setupShopItem({_inv}, 20, soul sand, "Cát Linh Hồn", 4800, 19200, 16, 64)
        setupShopItem({_inv}, 21, water bucket, "Xô Nước", 2000, 10000, 1, 5)
        setupShopItem({_inv}, 22, lava bucket, "Xô Dung Nham", 2000, 10000, 1, 5)
        setupShopItem({_inv}, 29, egg, "Trứng Heo", 15000, 75000, 1, 5)
        setupShopItem({_inv}, 30, egg, "Trứng Cừu", 15000, 75000, 1, 5)
        setupShopItem({_inv}, 31, egg, "Trứng Bò", 15000, 75000, 1, 5)
        setupShopItem({_inv}, 32, egg, "Trứng Dân Làng", 150000, 750000, 1, 5)
        openStandardUI({_p}, {_inv}, "UI_SHOP_2", "UI_SHOP")

    else if {_cat} is 3:
        # Khoáng Sản & Giả Kim (54 ô)
        set {_inv} to createStandardUI({_p}, "UI_SHOP_3", "&8✦ &b&lKHOÁNG SẢN & GIẢ KIM SKYBLOCK &8✦", 6, diamond named " ", "UI_SHOP", "Siêu Thị /shop")
        setupShopItem({_inv}, 10, coal, "Than Đá", 300, 4800, 1, 16)
        setupShopItem({_inv}, 11, iron ingot, "Thỏi Sắt", 800, 12800, 1, 16)
        setupShopItem({_inv}, 12, gold ingot, "Thỏi Vàng", 1200, 19200, 1, 16)
        setupShopItem({_inv}, 13, redstone, "Bột Đá Đỏ", 500, 8000, 1, 16)
        setupShopItem({_inv}, 14, lapis lazuli, "Ngọc Lưu Ly (Lapis)", 500, 8000, 1, 16)
        setupShopItem({_inv}, 15, diamond, "Kim Cương", 3500, 56000, 1, 16)
        setupShopItem({_inv}, 16, emerald, "Ngọc Lục Bảo", 5000, 80000, 1, 16)
        setupShopItem({_inv}, 19, blaze rod, "Que Quỷ Lửa", 2500, 40000, 1, 16)
        setupShopItem({_inv}, 20, ender pearl, "Ngọc Ender", 3000, 48000, 1, 16)
        setupShopItem({_inv}, 21, cobweb, "Mạng Nhện", 400, 6400, 1, 16)
        setupShopItem({_inv}, 22, golden apple, "Táo Vàng", 20000, 100000, 1, 5)
        setupShopItem({_inv}, 23, shield, "Khiên Gỗ", 10000, 10000, 1, 1)
        setupShopItem({_inv}, 24, totem of undying, "Totem Bất Tử", 150000, 150000, 1, 1)
        setupShopItem({_inv}, 25, nether star, "Ngôi Sao Địa Ngục", 250000, 250000, 1, 1)
        openStandardUI({_p}, {_inv}, "UI_SHOP_3", "UI_SHOP")

    else if {_cat} is 4:
        # Khối Uy Danh & Spawners Đảo (54 ô)
        set {_inv} to createStandardUI({_p}, "UI_SHOP_4", "&8✦ &d&lKHỐI UY DANH & LỒNG SPAWNERS &8✦", 6, beacon named " ", "UI_SHOP", "Siêu Thị /shop")
        setupShopSingleItem({_inv}, 10, diamond block, "&b&l✦ KHỐI KIM CƯƠNG ✦", 35000, ("&7Tăng Uy Danh Căn Cứ &b+150 Level"))
        setupShopSingleItem({_inv}, 11, emerald block, "&a&l✦ KHỐI LỤC BẢO ✦", 50000, ("&7Tăng Uy Danh Căn Cứ &a+200 Level"))
        setupShopSingleItem({_inv}, 12, beacon, "&e&l✦ BEACON CĂN CỨ ✦", 300000, ("&7Tăng Uy Danh Căn Cứ &e+500 Level"))
        setupShopSingleItem({_inv}, 13, dragon egg, "&5&l✦ TRỨNG RỒNG ENDER ✦", 800000, ("&7Tăng Uy Danh Căn Cứ &5+1,000 Level"))

        setupShopSingleItem({_inv}, 19, monster spawner, "&c&l✦ LỒNG SPAWNER: ZOMBIE ✦", 20000, ("&7Sinh quái Zombie tự động"))
        setupShopSingleItem({_inv}, 20, monster spawner, "&f&l✦ LỒNG SPAWNER: SKELETON ✦", 20000, ("&7Sinh quái Skeleton tự động"))
        setupShopSingleItem({_inv}, 21, monster spawner, "&a&l✦ LỒNG SPAWNER: CREEPER ✦", 35000, ("&7Sinh quái Creeper tự động"))
        setupShopSingleItem({_inv}, 22, monster spawner, "&4&l✦ LỒNG SPAWNER: SPIDER ✦", 35000, ("&7Sinh quái Nhện tự động"))
        setupShopSingleItem({_inv}, 23, monster spawner, "&6&l✦ LỒNG SPAWNER: BLAZE ✦", 50000, ("&7Sinh quái Quỷ Lửa tự động"))
        setupShopSingleItem({_inv}, 24, monster spawner, "&9&l✦ LỒNG SPAWNER: IRON GOLEM ✦", 350000, ("&7Sinh Người Sắt - Uy Danh &b+5,000 Level"))
        openStandardUI({_p}, {_inv}, "UI_SHOP_4", "UI_SHOP")

function setupShopItem(inv: inventory, sl: number, it: item, nameStr: text, p1: number, p2: number, q1: number, q2: number):
    delete {_lore::*}
    set {_lore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_lore::2} to "&7Vật phẩm: &f%{_nameStr}%"
    set {_lore::3} to ""
    set {_lore::4} to "&a• Click Trái: &fMua x%{_q1}% &7(&a$%routerFormatNumber({_p1})%&7)"
    if {_q2} > {_q1}:
        set {_lore::5} to "&e• Click Phải: &fMua x%{_q2}% &7(&a$%routerFormatNumber({_p2})%&7)"
    set {_lore::6} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_i} to {_it}
    set name of {_i} to colored "&f&l%{_nameStr}%"
    set lore of {_i} to {_lore::*}
    set slot {_sl} of {_inv} to {_i}

function setupShopSingleItem(inv: inventory, sl: number, it: item, nameStr: text, price: number, extraLore: texts):
    delete {_lore::*}
    set {_lore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_lore::2} to "&7Giá niêm yết: &a$%routerFormatNumber({_price})% Money"
    set {_lore::3} to ""
    if {_extraLore::*} is set:
        loop {_extraLore::*}:
            add loop-value to {_lore::*}
        add "" to {_lore::*}
    add "&a▸ Nhấp chuột để Mua x1!" to {_lore::*}
    add "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" to {_lore::*}
    set {_i} to makeGlowingItem({_it}, {_nameStr}, {_lore::*})
    set slot {_sl} of {_inv} to {_i}

# =====================================================================
# PHẦN 3: CỬA HÀNG COIN BẢO VẬT RPG & RANK (/cshop - 100% COIN)
# =====================================================================

function openCoinShopHubGUI(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_coinBal} to getCoinBalance({_p})
    set {_coinStr} to routerFormatNumber({_coinBal})

    set {_inv} to createStandardUI({_p}, "UI_CSHOP", "&8✦ &6&lCỬA HÀNG COIN BẢO VẬT & RANK &8✦", 4, gold ingot named " ", "UI_G6_C", "Trung Tâm Giao Thương")

    # Slot 4: Ví Coin
    delete {_vLore::*}
    set {_vLore::1} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_vLore::2} to "&8▪ &7Coin Sức Mạnh: &6%{_coinStr}% Coin"
    set {_vLore::3} to "&8▪ &7Tỷ Giá Ngân Hàng: &a$10,000 &f= &61 Coin"
    set {_vLore::4} to ""
    set {_vLore::5} to "&e▸ Dùng Coin mua Rank vĩnh viễn, Bảo Vật Ác Quỷ,"
    set {_vLore::6} to "&e  Rương Trang Bị AoV và mở lối tắt Xưởng Rèn!"
    set {_vLore::7} to "&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    set {_pName} to name of {_p}
    set slot 4 of {_inv} to makePlayerProfileHead({_p}, {_pName}, {_vLore::*}, "&6&l✦ VÍ COIN NGƯỜI CHƠI ✦")

    # Slot 10: Tab 1 - Thăng Hạng Rank
    set slot 10 of {_inv} to makeGlowingItem(nether star, "&e&l✦ TAB 1: THĂNG HẠNG RANK VIP ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Nâng cấp Rank VIP, KING, MASTER vĩnh viễn." and "&7Tăng Multiplier bán đồ, fly và quyền lợi đảo!" and "" and "&e▸ Nhấn để xem các gói Rank!"))

    # Slot 12: Tab 2 - Bảo Vật Ác Quỷ & Thiên Phú
    set slot 12 of {_inv} to makeCustomRPItem("df_chest", "&c&l✦ TAB 2: BẢO VẬT ÁC QUỶ & TP ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Đá Thức Tỉnh, Bùa Tinh Tú, Trái Bí Ẩn," and "&7Quả Cầu Tẩy Thiên Phú, Rumble Ball..." and "" and "&c▸ Nhấn để xem bảo vật!"))

    # Slot 14: Tab 3 - Rương AoV & Phù Phép CE
    set slot 14 of {_inv} to makeCustomRPItem("aov_chest", "&b&l✦ TAB 3: RƯƠNG AOV & PHÙ PHÉP CE ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Rương Trang Bị Liên Quân Sử Thi 3D," and "&7Bụi Tăng Tỷ Lệ & Giấy Bảo Hiểm CrazyEnchants!" and "" and "&b▸ Nhấn để xem rương & bùa!"))

    # Slot 16: Tab 4 - Lối Tắt 3 Xưởng Sức Mạnh
    set slot 16 of {_inv} to makeCustomRPItem("yoru", "&d&l✦ TAB 4: LỐI TẮT 3 ĐẠI XƯỞNG RÈN ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Mở nhanh Xưởng 12 Trang Bị AoV, Lò Rèn Giáp" and "&7và Xưởng 13 Danh Kiếm One Piece (Thuần Coin)!" and "" and "&d▸ Nhấn để mở lối tắt!"))

    # Slot 22: Ngân Hàng Quy Đổi
    set slot 22 of {_inv} to makeGlowingItem(emerald, "&a&l✦ NGÂN HÀNG QUY ĐỔI (/nganhang) ✦", ("&8&m⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯" and "&7Nạp thêm Coin bằng Money mặt với tỷ giá $10,000 = 1 Coin." and "" and "&a▸ Nhấp để vào Ngân Hàng"))

    openStandardUI({_p}, {_inv}, "UI_CSHOP", "UI_G6_C")

function openCoinShopTabGUI(p: player, tab: number):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_coinBal} to getCoinBalance({_p})
    set {_coinStr} to routerFormatNumber({_coinBal})

    if {_tab} is 1:
        # Tab 1: Thăng Hạng Rank (36 ô)
        set {_inv} to createStandardUI({_p}, "UI_CSHOP_1", "&8✦ &e&lTHĂNG HẠNG RANK VIP (VĨNH VIỄN) &8✦", 4, nether star named " ", "UI_CSHOP", "Cửa Hàng /cshop")

        # Rank VIP (300 Coin)
        delete {_lore1::*}
