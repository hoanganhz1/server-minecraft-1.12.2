            return 8
        return 0
    if {_wid} is "wado_ichimonji":
        if {_stat} is "atk":
            return 17
        if {_stat} is "crit":
            return 9
        return 0
    if {_wid} is "nidai_kitetsu":
        if {_stat} is "atk":
            return 21
        if {_stat} is "crit":
            return 11
        return 6
    if {_wid} is "shusui":
        if {_stat} is "atk":
            return 22
        if {_stat} is "crit":
            return 12
        return 10
    if {_wid} is "gryphon":
        if {_stat} is "atk":
            return 22
        if {_stat} is "crit":
            return 12
        return 10
    if {_wid} is "kikoku":
        if {_stat} is "atk":
            return 21
        if {_stat} is "crit":
            return 10
        return 8
    if {_wid} is "soul_solid":
        if {_stat} is "atk":
            return 21
        if {_stat} is "crit":
            return 10
        return 6
    if {_wid} is "enma":
        if {_stat} is "atk":
            return 26
        if {_stat} is "crit":
            return 15
        return 12
    if {_wid} is "ame_no_habakiri":
        if {_stat} is "atk":
            return 26
        if {_stat} is "crit":
            return 15
        return 12
    if {_wid} is "yoru":
        if {_stat} is "atk":
            return 28
        if {_stat} is "crit":
            return 15
        return 12
    if {_wid} is "bisento":
        if {_stat} is "atk":
            return 27
        if {_stat} is "crit":
            return 12
        return 12
    if {_wid} is "murakumogiri":
        if {_stat} is "atk":
            return 27
        if {_stat} is "crit":
            return 12
