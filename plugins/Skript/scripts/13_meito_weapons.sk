    return 0

function getMeitoSheathedModelKey(wid: text) :: text:
    if {_wid} is "sandai_kitetsu":
        return "sandai_kitetsu_sheathed"
    if {_wid} is "wado_ichimonji":
        return "wado_ichimonji_sheathed"
    if {_wid} is "nidai_kitetsu":
        return "nidai_kitetsu_sheathed"
    if {_wid} is "shusui":
        return "shusui_sheathed"
    if {_wid} is "soul_solid":
        return "soul_solid_sheathed"
    if {_wid} is "enma":
        return "enma_sheathed"
    if {_wid} is "ame_no_habakiri":
        return "ame_no_habakiri_sheathed"
    return {_wid}

function getMeitoHakiModelKey(wid: text) :: text:
    if {_wid} is "katana":
        return "katana_overlay_haki"
