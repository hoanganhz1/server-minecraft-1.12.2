# =====================================================================
# HỆ THỐNG 13 DANH KIẾM & VŨ KHÍ ĐẶC CHỦNG (PHASE 13 - SKBEE + REFLECT)
# - Kiến trúc Resource Pack Vanilla Durability Predicate (diamond hoe 1561)
# - Máy trạng thái biến hình động In-place: Tra Vỏ -> Rút Kiếm -> Bọc Haki
# - Cơ chế Kiếm Khí đòn thứ 4, Tầm đánh mở rộng & Sát thương quét lan
# - Luyện Hắc Kiếm Vĩnh Viễn (Permanent Black Blade Awakening)
# - GUI Xưởng Rèn Danh Kiếm /danhkiem
# =====================================================================

import:
    java.lang.System
    java.util.UUID
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.Sound
    org.bukkit.entity.Player
    org.bukkit.entity.LivingEntity
    org.bukkit.inventory.ItemStack
    org.bukkit.event.inventory.InventoryDragEvent

# ---------------------------------------------------------------------
# 1. HÀM TRA CỨU MÔ HÌNH VÀ THÔNG SỐ DANH KIẾM
# ---------------------------------------------------------------------

function getMeitoDisplayName(wid: text) :: text:
    if {_wid} is "katana":
        return "&f&lThái Đao Hải Tặc"
    if {_wid} is "sandai_kitetsu":
        return "&c&lTam Đại Quỷ Triệt"
    if {_wid} is "wado_ichimonji":
        return "&b&lHòa Đạo Nhất Văn Tự"
    if {_wid} is "nidai_kitetsu":
        return "&5&lNhị Đại Quỷ Triệt"
    if {_wid} is "shusui":
        return "&d&lHắc Bảo Kiếm Thu Thủy"
    if {_wid} is "gryphon":
        return "&6&lThánh Kiếm Gryphon"
    if {_wid} is "kikoku":
        return "&e&lQuỷ Khốc Kikoku"
    if {_wid} is "soul_solid":
        return "&3&lHồn Kiếm Soul Solid"
    if {_wid} is "enma":
        return "&5&l✦ Diêm Ma Enma ✦"
    if {_wid} is "ame_no_habakiri":
        return "&b&l✦ Thiên Vũ Vũ Trảm ✦"
    if {_wid} is "yoru":
        return "&2&l✦ Hắc Kiếm Yoru ✦"
    if {_wid} is "bisento":
        return "&6&l✦ Đại Đao Bisento ✦"
    if {_wid} is "murakumogiri":
        return "&c&l✦ Thiên Tùng Vân Thiết ✦"
    return "&7Danh Kiếm"

function getMeitoTier(wid: text) :: number:
    if {_wid} is "katana":
        return 1
    if {_wid} is "sandai_kitetsu" or "wado_ichimonji":
        return 2
    if {_wid} is "nidai_kitetsu" or "shusui" or "gryphon" or "kikoku" or "soul_solid":
        return 3
    if {_wid} is "enma" or "ame_no_habakiri" or "yoru" or "bisento" or "murakumogiri":
        return 4
    return 1

