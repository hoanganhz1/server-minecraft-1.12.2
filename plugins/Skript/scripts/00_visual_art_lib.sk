# ---------------------------------------------------------------------
# 2. HÀM TẠO VẬT PHẨM RESOURCE PACK & 3D RIG ITEM
# ---------------------------------------------------------------------
function isValidItem(item: item) :: boolean:
    if {_item} is not set:
        return false
    if {_item} is air:
        return false
    if type of {_item} is air:
        return false
    return true

function get3DModelDamageId(key: text) :: number:
    return getCustomModelDataId({_key})

function makeCustomRPItem(key: text, itemName: text, itemLore: texts) :: item:
    set {_id} to getCustomModelDataId({_key})
    if {_id} is not set:
        set {_id} to 1
    set {_item} to 1 of diamond hoe
    if {_itemName} is set:
        set name of {_item} to colored {_itemName}
    if {_itemLore::*} is set:
        set lore of {_item} to {_itemLore::*}
    set data value of {_item} to {_id}
    set damage of {_item} to {_id}
    set {_nbt} to nbt compound of {_item}
    set byte tag "Unbreakable" of {_nbt} to 1
    set int tag "HideFlags" of {_nbt} to 63
    set string tag "CustomModelKey" of {_nbt} to {_key}
    set data value of {_item} to {_id}
    set damage of {_item} to {_id}
    return {_item}

function create3DRigItem(key: text) :: item:
    set {_id} to get3DModelDamageId({_key})
    if {_id} is not set:
        set {_id} to 60
    set {_item} to 1 of diamond hoe
    set name of {_item} to "&73D_RIG_%{_key}%"
    set data value of {_item} to {_id}
    set damage of {_item} to {_id}
    set {_nbt} to nbt compound of {_item}
    set byte tag "Unbreakable" of {_nbt} to 1
    set int tag "HideFlags" of {_nbt} to 63
    set byte tag "Is3DRig" of {_nbt} to 1
    set string tag "CustomModelKey" of {_nbt} to {_key}
    set data value of {_item} to {_id}
    set damage of {_item} to {_id}
    return {_item}

function apply3DModelToEntity(e: entity, key: text):
    if {_e} is not set:
        stop
    set {_rig} to create3DRigItem({_key})
    set helmet of {_e} to {_rig}
    if {_e} is an armor stand:
        set {_entNbt} to nbt compound of {_e}
        set int tag "DisabledSlots" of {_entNbt} to 2039583
        set byte tag "NoBasePlate" of {_entNbt} to 1

function play3DEntityPose(e: entity, poseKey: text, revertKey: text, ticks: number):
    if {_e} is not set:
        stop
    if {_e} is not alive:
        stop
    set {_uuid} to uuid of {_e}
    set {_poseItem} to create3DRigItem({_poseKey})
    set helmet of {_e} to {_poseItem}
    set {entity_3d_pose_lock::%{_uuid}%} to {_poseKey}
    wait "%{_ticks}% ticks" parsed as timespan
    if {_e} is alive:
        if {entity_3d_pose_lock::%{_uuid}%} is {_poseKey}:
            delete {entity_3d_pose_lock::%{_uuid}%}
            set {_revItem} to create3DRigItem({_revertKey})
            set helmet of {_e} to {_revItem}

# ---------------------------------------------------------------------
# 3. TƯƠNG THÍCH NGƯỢC VỚI HỆ THỐNG ĐẦU 3D CŨ (FORWARDING SANG RP)
# ---------------------------------------------------------------------
function b64FromTextureHash(hashOrB64: text) :: text:
    if {_hashOrB64} starts with "eyJ":
        return {_hashOrB64}
    set {_json} to "{""textures"":{""SKIN"":{""url"":""http://textures.minecraft.net/texture/%{_hashOrB64}%""}}}"
    set {_bytes} to {_json}.getBytes(StandardCharsets.UTF_8)
    return Base64.getEncoder().encodeToString({_bytes})

function getTextureUUID(seed: text) :: text:
    set {_bytes} to {_seed}.getBytes(StandardCharsets.UTF_8)
    return UUID.nameUUIDFromBytes({_bytes}).toString()

