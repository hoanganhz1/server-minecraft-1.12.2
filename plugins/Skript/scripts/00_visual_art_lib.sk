# ---------------------------------------------------------------------
# 1. BẢNG ÁNH XẠ DAMAGE ID RESOURCE PACK (DURABILITY ID 1..1550 TRÊN DIAMOND_HOE)
# ---------------------------------------------------------------------
function loadRPModelRegistry():
    delete {rp_model_id::*}
    set {_f} to new File("plugins/Skript/rp_models.txt")
    if {_f}.exists() is true:
        set {_scanner} to new Scanner({_f})
        set {_cnt} to 0
        while {_scanner}.hasNextLine() is true:
            set {_line} to {_scanner}.nextLine()
            set {_idx} to {_line}.indexOf(":")
            if {_idx} > 0:
                set {_k} to lowercase {_line}.substring(0, {_idx})
                set {_vStr} to {_line}.substring({_idx} + 1)
                set {_v} to {_vStr} parsed as number
                if {_v} is set:
                    set {rp_model_id::%{_k}%} to {_v}
                    add 1 to {_cnt}
        {_scanner}.close()
        send "[VisualArtLib] Đã nạp %{_cnt}% Model ID từ rp_models.txt" to console

on load:
    loadRPModelRegistry()

function getCustomModelDataId(key: text) :: number:
