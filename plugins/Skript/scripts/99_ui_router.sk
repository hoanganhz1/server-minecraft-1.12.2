# ---------------------------------------------------------------------
# 11. SỰ KIỆN QUẢN LÝ TRẠNG THÁI & ĐIỀU PHỐI CLICK/DRAG
# ---------------------------------------------------------------------

on inventory close:
    set {_u} to uuid of player
    # Bảo vệ trạng thái khi đang chuyển trang giữa 2 GUI
    if {ui_switching::%{_u}%} is true:
        delete {ui_switching::%{_u}%}
        stop
    delete {ui_active::%{_u}%}
    delete {ui_parent::%{_u}%}

on quit:
    set {_u} to uuid of player
    delete {ui_active::%{_u}%}
    delete {ui_parent::%{_u}%}
    delete {ui_switching::%{_u}%}

on InventoryDragEvent:
    set {_who} to event.getWhoClicked()
    if {_who} is a player:
        set {_u} to uuid of {_who}
        if {ui_active::%{_u}%} is set:
            cancel event

on inventory click:
    set {_u} to uuid of player
    if {ui_active::%{_u}%} is not set:
        stop

    # Khóa cứng chống mọi thao tác di chuyển item Vanilla cho toàn bộ 26 GUI
    cancel event
    set {_clickType} to "%click type%"
    if {_clickType} contains "SHIFT" or "NUMBER" or "DOUBLE" or "SWAP" or "DROP":
        player.updateInventory()

    # Nếu click vào túi đồ dưới của người chơi thì chỉ chặn (đã cancel event ở trên), không xử lý nút bấm GUI
    if clicked inventory is not player's current inventory:
        stop

    set {_slot} to index of event-slot
    set {_item} to slot {_slot} of player's current inventory

    set {_activeUI} to {ui_active::%{_u}%}
    set {_parentUI} to {ui_parent::%{_u}%}

    # =================================================================
    # A. XỬ LÝ TRỌN GÓI CHO CẤP 1 VÀ CẤP 2 (UI_ROOT, UI_G1..UI_G6)
    # =================================================================
    if {_activeUI} is "UI_ROOT" or "UI_G1" or "UI_G2" or "UI_G3" or "UI_G4" or "UI_G5" or "UI_G6":
        # 1. Nút Quay Lại Menu Cha (Slot 27 hoặc 45)
        if {_slot} is 27 or 45:
            if {_item} is set:
                if "%type of {_item}%" contains "arrow":
                    if {_parentUI} is set:
                        if {_parentUI} is not "NONE":
                            play sound "UI_BUTTON_CLICK" with volume 1 and pitch 1 to player
                            wait 1 tick
                            openMenuById(player, {_parentUI})
                            stop

        # 2. Nút Về Menu Tổng
        else if {_slot} is 28 or 46:
            if {_item} is set:
                if "%type of {_item}%" contains "compass":
                    play sound "UI_BUTTON_CLICK" with volume 1 and pitch 1.2 to player
                    wait 1 tick
                    openMenuById(player, "UI_ROOT")
                    stop

        # 3. Nút Đóng Giao Diện
        else if {_slot} is 35 or 53:
            if {_item} is set:
                if "%type of {_item}%" contains "barrier":
                    play sound "BLOCK_NOTE_BASS" with volume 1 and pitch 1 to player
                    delete {ui_active::%{_u}%}
                    delete {ui_parent::%{_u}%}
                    close player's inventory
                    wait 1 tick
                    close player's inventory
                    stop

        # 4. Điều hướng từng màn hình Cấp 1 & Cấp 2
        if {_activeUI} is "UI_ROOT":
            if {_slot} is 4:
                play sound "ENTITY_EXPERIENCE_ORB_PICKUP" with volume 1 and pitch 1.2 to player
            else if {_slot} is 20:
                wait 1 tick
                openMenuById(player, "UI_G1")
            else if {_slot} is 22:
                wait 1 tick
                openMenuById(player, "UI_G2")
            else if {_slot} is 24:
                wait 1 tick
                openMenuById(player, "UI_G3")
            else if {_slot} is 29:
                wait 1 tick
                openMenuById(player, "UI_G4")
            else if {_slot} is 31:
                wait 1 tick
                openMenuById(player, "UI_G5")
            else if {_slot} is 33:
                wait 1 tick
                openMenuById(player, "UI_G6")
            else if {_slot} is 47:
                set {ui_bank_return::%{_u}%} to "UI_ROOT"
                wait 1 tick
                openMenuById(player, "UI_BANK")
            else if {_slot} is 49:
                wait 1 tick
                close player's inventory
                delete {ui_active::%{_u}%}
                delete {ui_parent::%{_u}%}
                wait 1 tick
                make player execute command "bangdiem"

        else if {_activeUI} is "UI_G1":
            if {_slot} is 10:
                wait 1 tick
                openMenuById(player, "UI_G1_A")
            else if {_slot} is 12:
                wait 1 tick
                openMenuById(player, "UI_G1_B")
            else if {_slot} is 14:
                wait 1 tick
                openMenuById(player, "UI_G1_C")
            else if {_slot} is 16:
                wait 1 tick
                openMenuById(player, "UI_G1_D")

        else if {_activeUI} is "UI_G2":
            if {_slot} is 11:
                wait 1 tick
                openMenuById(player, "UI_G2_A")
            else if {_slot} is 13:
                wait 1 tick
                openMenuById(player, "UI_G2_B")
            else if {_slot} is 15:
                wait 1 tick
                openMenuById(player, "UI_G2_C")

        else if {_activeUI} is "UI_G3":
            if {_slot} is 11:
                wait 1 tick
                openMenuById(player, "UI_G3_A")
            else if {_slot} is 13:
                wait 1 tick
                openMenuById(player, "UI_G3_B")
            else if {_slot} is 15:
                wait 1 tick
                openMenuById(player, "UI_G3_C")

        else if {_activeUI} is "UI_G4":
            if {_slot} is 11:
                wait 1 tick
                openMenuById(player, "UI_G4_A")
            else if {_slot} is 13:
                wait 1 tick
                openMenuById(player, "UI_G4_B")
            else if {_slot} is 15:
                wait 1 tick
                openMenuById(player, "UI_G4_C")

        else if {_activeUI} is "UI_G5":
            if {_slot} is 11:
                wait 1 tick
                openMenuById(player, "UI_G5_A")
            else if {_slot} is 13:
                wait 1 tick
                openMenuById(player, "UI_G5_B")
            else if {_slot} is 15:
                wait 1 tick
                openMenuById(player, "UI_G5_C")
            else if {_slot} is 22:
                if {disciple::%{_u}%::has} is true:
                    sendSystemMsg(player, "warning", "Bạn đã sở hữu Đệ Tử Đồng Hành rồi!")
                    play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
                    stop
                if getCoinBalance(player) < 1000:
                    sendSystemMsg(player, "error", "Bạn không đủ Coin! Cần 1,000 Coin để mở khóa Đệ Tử (Đổi tại /nganhang).")
                    play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
                    stop
                takeCoinBalance(player, 1000)
                set {disciple::%{_u}%::has} to true
                set {disciple::%{_u}%::power} to 2000
                set {disciple::%{_u}%::stamina} to 1000
                set {disciple::%{_u}%::mode} to "follow"
                set {disciple::%{_u}%::ate_fruit} to false
                set {_r} to random integer between 1 and 2
                if {_r} is 1:
                    set {disciple::%{_u}%::style} to "kiem_dao"
                else:
                    set {disciple::%{_u}%::style} to "luc_thuc"
                spawnOrUpdateDisciple(player)
                set {_pName} to name of player
                broadcastDualCard("&6&l✦ ĐỆ TỬ ĐỒNG HÀNH", "%{_pName}% đã mở khóa thành công Đệ Tử Đồng Hành!", "Một trợ thủ đắc lực với 2,000 Sức Mạnh đã gia nhập chiến trường Hải Tặc! (-1,000 Coin)")
                play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.2 to player
                wait 1 tick
                openMenuById(player, "UI_G5")

        else if {_activeUI} is "UI_G6":
            if {_slot} is 11:
                wait 1 tick
                openMenuById(player, "UI_G6_A")
            else if {_slot} is 13:
                wait 1 tick
                openMenuById(player, "UI_G6_B")
            else if {_slot} is 15:
                wait 1 tick
                openMenuById(player, "UI_G6_C")

    # =================================================================
    # B. XỬ LÝ ĐIỀU HƯỚNG CỐT LÕI CHO CÁC MÀN HÌNH CẤP 3 (UI_G*_A..D & CÁC SUB-MENU)
    # =================================================================
    else:
        # 1. Nút Quay Lại Menu Cha (Slot 27 hoặc 45)
        if {_slot} is 27 or 45:
            if {_item} is set:
                if "%type of {_item}%" contains "arrow":
                    if {_parentUI} is set:
                        if {_parentUI} is not "NONE":
                            play sound "UI_BUTTON_CLICK" with volume 1 and pitch 1 to player
                            wait 1 tick
                            openMenuById(player, {_parentUI})
                            stop

        # 2. Nút Về Menu Tổng
        else if {_slot} is 28 or 46:
            if {_item} is set:
                if "%type of {_item}%" contains "compass":
                    play sound "UI_BUTTON_CLICK" with volume 1 and pitch 1.2 to player
                    wait 1 tick
                    openMenuById(player, "UI_ROOT")
                    stop

        # 3. Nút Đóng Giao Diện
        else if {_slot} is 35 or 53:
            if {_item} is set:
                if "%type of {_item}%" contains "barrier":
                    play sound "BLOCK_NOTE_BASS" with volume 1 and pitch 1 to player
                    delete {ui_active::%{_u}%}
                    delete {ui_parent::%{_u}%}
                    close player's inventory
                    wait 1 tick
                    close player's inventory
                    stop

# ---------------------------------------------------------------------
# 12. HỆ THỐNG CÂU LỆNH ĐIỀU HƯỚNG (/menu, /nangluc, /chientruong...)
# ---------------------------------------------------------------------

command /menu:
    aliases: /onepiece, /rpgmenu
    trigger:
        openMenuById(player, "UI_ROOT")

command /nangluc:
    trigger:
        openMenuById(player, "UI_G1")

command /chientruong:
    trigger:
        openMenuById(player, "UI_G2")

command /sucmanh:
    trigger:
        openMenuById(player, "UI_G3")

command /hamdoi:
    trigger:
        openMenuById(player, "UI_G6")

command /chetao:
    aliases: /forge
    trigger:
        openMenuById(player, "UI_G4")

command /detu [<text>] [<text>]:
    aliases: /pet, /disciple
    trigger:
        set {_sub} to lowercase (arg-1 ? "")
        if {_sub} is "gear":
            openMenuById(player, "UI_G5_A")
        else if {_sub} is "porata":
            openMenuById(player, "UI_G5_B")
        else if {_sub} is "skill" or "skills":
            openMenuById(player, "UI_G5_C")
        else if {_sub} is "home" or "venha" or "thuhoi":
            set {_u} to uuid of player
            if {disciple::%{_u}%::has} is not true:
                sendSystemMsg(player, "error", "Bạn chưa có Đệ Tử Đồng Hành!")
                stop
            set {disciple::%{_u}%::mode} to "home"
            despawnDisciple(player)
            sendSystemMsg(player, "info", "Đã thu hồi Đệ Tử về nhà nghỉ ngơi!")
            play sound "BLOCK_WOODEN_DOOR_CLOSE" with volume 1 and pitch 1 to player
        else if {_sub} is "call" or "follow" or "trieuhoi":
            set {_u} to uuid of player
            if {disciple::%{_u}%::has} is not true:
                sendSystemMsg(player, "error", "Bạn chưa có Đệ Tử Đồng Hành!")
                stop
            set {disciple::%{_u}%::mode} to "follow"
            spawnOrUpdateDisciple(player)
            sendSystemMsg(player, "success", "Đã triệu hồi Đệ Tử xuất chiến (Đi Theo)!")
            play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to player
        else if {_sub} is "buy" or "unlock" or "modetu":
            set {_u} to uuid of player
            if {disciple::%{_u}%::has} is true:
                sendSystemMsg(player, "warning", "Bạn đã sở hữu Đệ Tử Đồng Hành rồi!")
                stop
            if getCoinBalance(player) < 1000:
                sendSystemMsg(player, "error", "Bạn không đủ Coin! Cần 1,000 Coin để mở khóa Đệ Tử (Đổi tại /nganhang).")
                stop
            takeCoinBalance(player, 1000)
            set {disciple::%{_u}%::has} to true
            set {disciple::%{_u}%::power} to 2000
            set {disciple::%{_u}%::stamina} to 1000
            set {disciple::%{_u}%::mode} to "follow"
            set {disciple::%{_u}%::ate_fruit} to false
            set {_r} to random integer between 1 and 2
            if {_r} is 1:
                set {disciple::%{_u}%::style} to "kiem_dao"
            else:
                set {disciple::%{_u}%::style} to "luc_thuc"
            spawnOrUpdateDisciple(player)
            set {_pName} to name of player
            broadcastDualCard("&6&l✦ ĐỆ TỬ ĐỒNG HÀNH", "%{_pName}% đã mở khóa thành công Đệ Tử Đồng Hành!", "Một trợ thủ đắc lực với 2,000 Sức Mạnh đã gia nhập chiến trường Hải Tặc! (-1,000 Coin)")
            play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.2 to player
        else if {_sub} is "name" or "doiten":
            set {_u} to uuid of player
            if {disciple::%{_u}%::has} is not true:
                sendSystemMsg(player, "error", "Bạn chưa có Đệ Tử Đồng Hành!")
                stop
            if arg-2 is not set:
                sendSystemMsg(player, "error", "Hãy nhập tên mới cho Đệ Tử: &e/detu name <tên>")
                stop
            set {_newName} to colored arg-2
            set {disciple::%{_u}%::name} to {_newName}
            spawnOrUpdateDisciple(player)
            sendSystemMsg(player, "success", "Đã đổi tên Đệ Tử thành: %{_newName}%&a!")
            play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1 to player
        else:
            openMenuById(player, "UI_G5")
