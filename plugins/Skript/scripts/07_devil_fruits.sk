# =====================================================================
# HỆ THỐNG TRÁI ÁC QUỶ ONE PIECE (MINECRAFT 1.12.2 - SKRIPT 2.6.4 + SKBEE + REFLECT)
# STUDIO MASTER SPECIFICATION — CHẶNG 3 (07_devil_fruits.sk)
# 4 Trái: Mera Mera, Gomu Gomu, Ope Ope, Uouo Seiryu (Đầu 3D Base64)
# Lõi Ác Quỷ, Đá Thức Tỉnh, Thuốc Xóa Ác Quỷ đổi màu NBT
# Giới hạn 1 trái, Lời nguyền Biển cả, Mastery Lv.1-100, Thức Tỉnh
# 3 Chiêu thức qua Lõi Ác Quỷ (Giảm hồi chiêu AoV) & GUI /traiacquy
# =====================================================================

import:
    java.lang.System
    java.util.UUID
    java.nio.charset.StandardCharsets
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.Particle
    org.bukkit.Location
    org.bukkit.util.Vector
