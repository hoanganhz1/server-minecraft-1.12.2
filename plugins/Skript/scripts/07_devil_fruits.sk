    set {_lore::6} to "&a✔ An toàn 100%% không gây nổ tung cơ thể"
    set {_lore::7} to "&e▶ Nhấp Chuột Phải / Uống để thanh tẩy!"
    set {_lore::8} to "&8&m----------------------------------------"
    # Màu Tím Hắc Ám: 8388736 (RGB: 128, 0, 128)
    set {_item} to makeCustomPotion(8388736, "&5&l✦ &d&lTHUỐC XÓA NĂNG LỰC ÁC QUỶ &5&l✦", {_lore::*})
    set string tag "SkyblockItem" of nbt compound of {_item} to "df_remover"
    return {_item}

function getRandomFruitChestItem() :: item:
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &6Rương Báu Hải Tặc &8(Mở Ngẫu Nhiên)"
    set {_lore::3} to "&7Chứa đựng 1 trong 4 Trái Ác Quỷ Thần Thoại:"
    set {_lore::4} to "&f• &6Mera Mera no Mi &8(Hệ Logia Lửa)"
    set {_lore::5} to "&f• &dGomu Gomu no Mi &8(Hệ Paramecia Cao Su)"
    set {_lore::6} to "&f• &cOpe Ope no Mi &8(Hệ Paramecia Phẫu Thuật)"
    set {_lore::7} to "&f• &bUouo no Mi: Seiryu &8(Hệ Zoan Thanh Long)"
    set {_lore::8} to ""
