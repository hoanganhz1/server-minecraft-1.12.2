    org.bukkit.entity.LivingEntity
    org.bukkit.entity.Entity
    org.bukkit.event.inventory.InventoryDragEvent
    org.bukkit.event.player.PlayerSwapHandItemsEvent
    org.bukkit.event.player.PlayerItemHeldEvent

# ---------------------------------------------------------------------
# 1. HÀM TẠO VẬT PHẨM ĐỘC QUYỀN (3D BASE64 & POTION RGB)
# ---------------------------------------------------------------------

function getDevilFruitDisplayName(id: text) :: text:
    if {_id} is "mera":
        return "&6&lMera Mera no Mi &c(Hỏa Long)"
    if {_id} is "gomu":
        return "&d&lGomu Gomu no Mi &5(Cao Su)"
    if {_id} is "ope":
        return "&c&lOpe Ope no Mi &4(Phẫu Thuật)"
    if {_id} is "seiryu":
        return "&b&lUouo no Mi: Seiryu &3(Thanh Long)"
    if {_id} is "gura":
        return "&f&lGura Gura no Mi &7(Chấn Động)"
    if {_id} is "pika":
        return "&e&lPika Pika no Mi &6(Ánh Sáng)"
    if {_id} is "goro":
        return "&9&lGoro Goro no Mi &b(Sấm Sét)"
    if {_id} is "phoenix":
        return "&3&lTori Tori: Phoenix &b(Phượng Hoàng)"
    return "&7Trái Ác Quỷ Vô Danh"

function getDevilFruitItem(id: text) :: item:
    set {_skullKey} to "%{_id}%_fruit"
    set {_name} to ""
    delete {_lore::*}

    if {_id} is "mera":
        set {_name} to "&6&l✦ &c&lTRÁI MERA MERA NO MI &6&l✦"
        set {_lore::1} to "&8&m----------------------------------------"
        set {_lore::2} to "&7Loại: &cTrái Ác Quỷ &8| &eHệ: &6Logia (Nguyên Tố Lửa)"
        set {_lore::3} to "&7Độ hiếm: &6&lTHẦN THOẠI"
        set {_lore::4} to ""
        set {_lore::5} to "&6&l✦ NỘI TẠI NGUYÊN TỐ LỬA:"
        set {_lore::6} to "&f• &eMiễn nhiễm 100%% &7sát thương Lửa, Đốt cháy và Dung nham."
        set {_lore::7} to "&f• &eThân thể Hỏa Linh: &7Miễn nhiễm mọi đòn đánh thường nếu"
        set {_lore::8} to "  &7đối thủ &ckhông kích hoạt Haki Vũ Trang&7!"
        set {_lore::9} to ""
        set {_lore::10} to "&6&l✦ BỘ KỸ NĂNG (KÍCH HOẠT QUA LÕI ÁC QUỶ):"
        set {_lore::11} to "&f• &eChiêu 1: &6Hỏa Quyền &8(Chuột Phải - CD 5s)"
        set {_lore::12} to "  &7Phóng luồng hỏa diệm 14 block thiêu đốt và phát nổ mục tiêu."
        set {_lore::13} to "&f• &eChiêu 2: &cHỏa Giới Dai Enkai &8(Shift+Chuột Phải - CD 12s)"
        set {_lore::14} to "  &7Vòng lửa bán kính 5 block thiêu đốt và hất tung kẻ địch."
        set {_lore::15} to "&f• &eChiêu 3: &4Đại Hỏa Đế Entei &8(Phím F - CD 28s - Lv.60)"
