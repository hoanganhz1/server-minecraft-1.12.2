    set string tag "SkyblockItem" of nbt compound of {_item} to "df_%{_id}%"
    return {_item}

function getDevilCoreItem() :: item:
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &5Pháp Bảo Thần Bí &8(Vật Phẩm Kích Hoạt)"
    set {_lore::3} to "&7Nguồn gốc: &dTinh hoa ngưng tụ của mọi Trái Ác Quỷ"
    set {_lore::4} to ""
    set {_lore::5} to "&d&l✦ CƠ CHẾ KÍCH HOẠT KỸ NĂNG TRÊN TAY CHÍNH:"
    set {_lore::6} to "&f• &eChuột Phải: &fChiêu 1 &8(Độ thông thạo Lv.1)"
    set {_lore::7} to "&f• &eShift + Chuột Phải: &fChiêu 2 &8(Độ thông thạo Lv.25)"
    set {_lore::8} to "&f• &ePhím F (Đổi tay): &6Chiêu 3 / Tuyệt Kỹ &8(Độ thông thạo Lv.60)"
    set {_lore::9} to ""
    set {_lore::10} to "&b⏳ Hồi chiêu tự động giảm theo %% CDR Trang Bị Liên Quân!"
    set {_lore::11} to "&a✦ Thức Tỉnh sẽ giảm thêm 20%% hồi chiêu và tăng 25%% sát thương!"
    set {_lore::12} to "&8&m----------------------------------------"
    set {_item} to makeCustomRPItem("df_chest", "&d&l✦ &5&lLÕI ÁC QUỶ THẦN BÍ &d&l✦", {_lore::*})
    set string tag "SkyblockItem" of nbt compound of {_item} to "devil_core"
    return {_item}

function getAwakeningStoneItem() :: item:
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &eKhoáng Thạch Thần Thoại &8(Tiêu Hao)"
    set {_lore::3} to "&7Công dụng: &fDùng để &6&lTHỨC TỈNH TRÁI ÁC QUỶ"
    set {_lore::4} to "&7khi Độ Thông Thạo đạt &bLv.100 &7trong menu &e/traiacquy&7."
    set {_lore::5} to ""
    set {_lore::6} to "&6&l✦ HIỆU QUẢ SAU THỨC TỈNH:"
    set {_lore::7} to "&f• &c+25%% Sát thương kỹ năng &7(Vĩnh viễn mọi chiêu)"
    set {_lore::8} to "&f• &b-20%% Thời gian hồi chiêu &7(Cộng dồn với CDR Liên Quân)"
    set {_lore::9} to "&8&m----------------------------------------"
    set {_item} to makeCustomRPItem("skill_awaken", "&e&l✦ &6&lĐÁ THỨC TỈNH ÁNH SAO &e&l✦", {_lore::*})
    set string tag "SkyblockItem" of nbt compound of {_item} to "awakening_stone"
    return {_item}

function getFruitRemoverItem() :: item:
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &5Thần Dược Ma Thuật &8(Uống Tiêu Hao)"
    set {_lore::3} to "&7Công dụng: &fThanh tẩy toàn bộ sức mạnh Trái Ác Quỷ hiện tại,"
    set {_lore::4} to "&fgiúp bạn trở về người bình thường an toàn và có thể ăn trái khác."
