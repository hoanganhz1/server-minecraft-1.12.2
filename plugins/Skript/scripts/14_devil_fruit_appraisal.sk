# =====================================================================
# HỆ THỐNG GIÁM ĐỊNH & TRÁI ÁC QUỶ MỞ RỘNG TIER S (PHASE 14 - SKBEE + REFLECT)
# - Trái Ác Quỷ Bí Ẩn (unidentified_df) với 10 ngoại hình generic_fruit_1..10
# - Bàn Giám Định Vegapunk (UI_G1_C): Tỷ lệ 70% Epic & 30% Huyền Thoại Tier S
# - Chuỗi kinh tế khép kín 6 vật phẩm: Rương Thần Thoại, Trái Bí Ẩn, Rumble Ball,
#   Thuốc Xóa Trái, Đá Thức Tỉnh, Bùa Thức Tỉnh, Chiết Xuất Tinh Hoa Ác Quỷ
# - Bách Khoa Toàn Thư Trái Ác Quỷ (UI_G1_D): Thưởng sưu tập vĩnh viễn
# =====================================================================

import:
    java.lang.System
    java.util.UUID
    org.bukkit.Bukkit
    org.bukkit.Material
    org.bukkit.Sound
    org.bukkit.entity.Player
    org.bukkit.inventory.ItemStack
    org.bukkit.event.inventory.InventoryDragEvent
    org.black_ixx.playerpoints.PlayerPoints

# ---------------------------------------------------------------------
# 1. HÀM TẠO VẬT PHẨM TRÁI BÍ ẨN & VẬT PHẨM HỖ TRỢ
# ---------------------------------------------------------------------

function getUnidentifiedFruitItem() :: item:
    set {_rIdx} to random integer between 1 and 10
    set {_modelKey} to "generic_fruit_%{_rIdx}%"
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &dKho Báu Đại Dương &8(Chưa Giám Định)"
    set {_lore::3} to "&7Nguồn gốc: &fThu thập từ Đô Đốc / Rương Hoang Dã / Mỏ Cấp 5"
    set {_lore::4} to ""
    set {_lore::5} to "&e&l✦ NĂNG LỰC ẨN CHỨA BÊN TRONG:"
    set {_lore::6} to "&f• &a70%% Tỷ lệ: &bNhóm Sử Thi (Mera, Gomu, Ope, Seiryu)"
    set {_lore::7} to "&f• &630%% Tỷ lệ: &dNhóm Huyền Thoại Tier S"
    set {_lore::8} to "  &e(Gura Gura, Pika Pika, Goro Goro, Phoenix)"
    set {_lore::9} to ""
    set {_lore::10} to "&e▶ Mang đến &d/vegapunk &e(Phòng Thí Nghiệm Vegapunk)!"
    set {_lore::11} to "&8&m----------------------------------------"

    set {_item} to makeCustomRPItem({_modelKey}, "&d&l✦ TRÁI ÁC QUỶ BÍ ẨN ✦", {_lore::*})
    set {_nbt} to nbt compound of {_item}
    set string tag "SkyblockItem" of {_nbt} to "unidentified_df"
    set string tag "CustomModelKey" of {_nbt} to {_modelKey}
    return {_item}

function giveUnidentifiedFruit(p: player):
    if {_p} is not online:
        stop
    set {_fruit} to getUnidentifiedFruitItem()
    if {_p} can hold {_fruit}:
        give {_fruit} to {_p}
    else:
        drop {_fruit} at location of {_p}
        sendSystemMsg({_p}, "warning", "Túi đồ đầy! Trái Ác Quỷ Bí Ẩn đã rơi xuống chân bạn.")
    sendSystemMsg({_p}, "training", "Bạn đã nhận được &d1 Trái Ác Quỷ Bí Ẩn&f! Hãy mang đi &e/giamdinh&f.")
    play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to {_p}

function getRumbleBallItem() :: item:
    delete {_lore::*}
    set {_lore::1} to "&8&m----------------------------------------"
    set {_lore::2} to "&7Loại: &eDược Liệu Thần Bí &8(Tiêu Hao)"
    set {_lore::3} to "&7Tác dụng: &6Cường Hóa Biến Hình Hệ Zoan"
    set {_lore::4} to ""
    set {_lore::5} to "&6&l✦ HIỆU QUẢ TRONG 60 GIÂY (CD 90s):"
    set {_lore::6} to "&f• &c+15%% Sát thương kỹ năng hệ Zoan"
    set {_lore::7} to "&f• &b+40 DEF &7và hiệu ứng &fSpeed I"
    set {_lore::8} to "&f• Áp dụng cho cả Bản Thân & Đệ Tử có trái Zoan"
    set {_lore::9} to ""
    set {_lore::10} to "&e▶ Chuột Phải ngoài chế độ chiến đấu để dùng!"
    set {_lore::11} to "&8&m----------------------------------------"
    set {_item} to makeCustomRPItem("rumble_ball", "&e&l✦ VIÊN BIẾN HÌNH RUMBLE BALL ✦", {_lore::*})
    set string tag "SkyblockItem" of nbt compound of {_item} to "rumble_ball"
    return {_item}

