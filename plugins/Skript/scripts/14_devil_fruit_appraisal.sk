# ---------------------------------------------------------------------
# 2. HÀM TIỆN ÍCH KIỂM TRA & TRỪ NGUYÊN LIỆU THEO TAG NBT
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# 3. HỆ THỐNG ĐỒ GIÁM & THƯỞNG SƯU TẬP VĨNH VIỄN
# ---------------------------------------------------------------------

function registerFruitToPokedex(p: player, fruitId: text):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    if {df_unlocked_pokedex::%{_u}%::%{_fruitId}%} is not set:
        set {df_unlocked_pokedex::%{_u}%::%{_fruitId}%} to true
        set {_count} to size of {df_unlocked_pokedex::%{_u}%::*}
        set {_bonusDmg} to roundOneDecimal({_count} * 1.5)
        set {_dfName} to getDevilFruitDisplayName({_fruitId})
        sendSystemMsg({_p}, "talent", "Mở khóa Đồ Giám: %{_dfName}%&f! Tiến trình: &b%{_count}%/8 &8(+%{_bonusDmg}%%% ST Kỹ Năng)")
        play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.8 to {_p}

function getPokedexBonusMult(p: player) :: number:
    if {_p} is not online:
        return 1.0
    set {_u} to uuid of {_p}
    set {_cnt} to size of {df_unlocked_pokedex::%{_u}%::*}
    if {_cnt} > 8:
        set {_cnt} to 8
    set {_mult} to 1.0 + ({_cnt} * 0.015)
    return {_mult}

# ---------------------------------------------------------------------
# 4. GIAO DIỆN BÁCH KHOA TOÀN THƯ POKEDEX (UI_G1_D - 54 Ô)
# ---------------------------------------------------------------------

function openPokedexGUI(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_inv} to createStandardUI({_p}, "UI_G1_D", "&9&l✦ BÁCH KHOA TRÁI ÁC QUỶ ✦", 6, blue stained glass pane named " ", "UI_G1", "Năng Lực & Võ Học")

    # Hàng 2: 4 Trái Epic (Slot 10, 12, 14, 16)
    set {_epicFruits::1} to "mera"
    set {_epicFruits::2} to "gomu"
    set {_epicFruits::3} to "ope"
    set {_epicFruits::4} to "seiryu"
    set {_epicSlots::1} to 10
    set {_epicSlots::2} to 12
    set {_epicSlots::3} to 14
    set {_epicSlots::4} to 16

    loop 4 times:
        set {_f} to {_epicFruits::%loop-number%}
        set {_s} to {_epicSlots::%loop-number%}
        set {_fName} to getDevilFruitDisplayName({_f})
        delete {_pLore::*}
        set {_pLore::1} to "&8&m----------------------------------------"
        if {df_unlocked_pokedex::%{_u}%::%{_f}%} is true:
            set {_pLore::2} to "&a✔ Trạng thái: &eĐÃ MỞ KHÓA TRONG ĐỒ GIÁM"
            set {_pLore::3} to "&7Phẩm cấp: &bSử Thi (Epic)"
            set {_pLore::4} to "&7Thưởng vĩnh viễn: &c+1.5%% Sát Thương Kỹ Năng"
            set {_pLore::5} to "&8&m----------------------------------------"
            set {_item} to getDevilFruitItem({_f})
            set slot {_s} of {_inv} to {_item}
        else:
            set {_pLore::2} to "&c✖ Trạng thái: &7CHƯA MỞ KHÓA"
            set {_pLore::3} to "&7Phẩm cấp: &bSử Thi (Epic)"
            set {_pLore::4} to "&7Hãy giám định hoặc sở hữu để kích hoạt"
            set {_pLore::5} to "&7chỉ số cộng thêm cho bản thân."
            set {_pLore::6} to "&8&m----------------------------------------"
            set {_grayItem} to coal named "&8??? &7(Chưa Giám Định: %{_fName}%&7)" with lore {_pLore::*}
            set slot {_s} of {_inv} to {_grayItem}

    # Hàng 4: 4 Trái Tier S (Slot 28, 30, 32, 34)
    set {_mythicFruits::1} to "gura"
    set {_mythicFruits::2} to "pika"
    set {_mythicFruits::3} to "goro"
    set {_mythicFruits::4} to "phoenix"
    set {_mythicSlots::1} to 28
    set {_mythicSlots::2} to 30
    set {_mythicSlots::3} to 32
    set {_mythicSlots::4} to 34

    loop 4 times:
        set {_f} to {_mythicFruits::%loop-number%}
        set {_s} to {_mythicSlots::%loop-number%}
        set {_fName} to getDevilFruitDisplayName({_f})
        delete {_pLore::*}
        set {_pLore::1} to "&8&m----------------------------------------"
        if {df_unlocked_pokedex::%{_u}%::%{_f}%} is true:
            set {_pLore::2} to "&a✔ Trạng thái: &eĐÃ MỞ KHÓA TRONG ĐỒ GIÁM"
            set {_pLore::3} to "&7Phẩm cấp: &dHuyền Thoại (Tier S)"
            set {_pLore::4} to "&7Thưởng vĩnh viễn: &c+1.5%% Sát Thương Kỹ Năng"
            set {_pLore::5} to "&8&m----------------------------------------"
            set {_item} to getDevilFruitItem({_f})
            set slot {_s} of {_inv} to {_item}
        else:
            set {_pLore::2} to "&c✖ Trạng thái: &7CHƯA MỞ KHÓA"
            set {_pLore::3} to "&7Phẩm cấp: &dHuyền Thoại (Tier S)"
            set {_pLore::4} to "&7Hãy giám định tại &d/vegapunk &7để khai mở"
            set {_pLore::5} to "&7sức mạnh bảo vật tối thượng này."
            set {_pLore::6} to "&8&m----------------------------------------"
            set {_grayItem} to coal named "&8??? &7(Chưa Giám Định: %{_fName}%&7)" with lore {_pLore::*}
            set slot {_s} of {_inv} to {_grayItem}

    # Slot 49: Tổng kết thưởng sưu tập
    set {_unlockedCount} to size of {df_unlocked_pokedex::%{_u}%::*}
    set {_totalBonus} to roundOneDecimal({_unlockedCount} * 1.5)
    delete {_sumLore::*}
    set {_sumLore::1} to "&8&m----------------------------------------"
    set {_sumLore::2} to "&7Tiến trình sưu tập: &b%{_unlockedCount}%&7/&b8 Trái Ác Quỷ"
    set {_sumLore::3} to "&7Tổng sát thương kỹ năng cộng thêm: &c+%{_totalBonus}%%%"
    set {_sumLore::4} to ""
    set {_sumLore::5} to "&eMỗi trái mở khóa: &c+1.5%% ST Kỹ Năng &7(Tối đa: &c+12.0%%&7)"
    set {_sumLore::6} to "&8&m----------------------------------------"
    set {_sumItem} to makeCustomRPItem("devil_fruit_encyclopedia", "&6&l✦ TỔNG KẾT BỘ SƯU TẬP ✦", {_sumLore::*})
    set slot 49 of {_inv} to {_sumItem}

    openStandardUI({_p}, {_inv}, "UI_G1_D", "UI_G1")

# ---------------------------------------------------------------------
# 5. GIAO DIỆN PHÒNG THÍ NGHIỆM VEGAPUNK (UI_G1_C - 54 Ô)
# ---------------------------------------------------------------------

function openAppraisalGUI(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    set {_inv} to createStandardUI({_p}, "UI_G1_C", "&d&l✦ PHÒNG THÍ NGHIỆM VEGAPUNK ✦", 6, purple stained glass pane named " ", "UI_G1", "Năng Lực & Võ Học")

    # Đếm số lượng Tinh Hoa hiện có trong túi đồ
    set {_essenceCount} to countPlayerItemByTag({_p}, "df_essence")

    # Slot 13: Đổi Rương Trái Thần Thoại
    delete {_cLore::*}
    set {_cLore::1} to "&8&m----------------------------------------"
    set {_cLore::2} to "&7Mở ngẫu nhiên 1 trong 4 Trái Ác Quỷ Thần Thoại:"
    set {_cLore::3} to "&f• &6Mera Mera &8| &dGomu Gomu &8| &cOpe Ope &8| &bUouo: Seiryu"
    set {_cLore::4} to ""
    set {_cLore::5} to "&6&l✦ CHI PHÍ ĐỔI RƯƠNG:"
    set {_cLore::6} to "&f• Tiền mặt: &a$500,000"
    set {_cLore::7} to "&f• Nguyên liệu: &510x Tinh Hoa Ác Quỷ"
    set {_cLore::8} to ""
    set {_cLore::9} to "&a▶ Nhấp chuột để đổi rương!"
    set {_cLore::10} to "&8&m----------------------------------------"
    set {_cItem} to makeCustomRPItem("df_chest", "&6&l✦ ĐỔI RƯƠNG TRÁI THẦN THOẠI ✦", {_cLore::*})
    set slot 13 of {_inv} to {_cItem}

    # Slot 20: Mua Trái Ác Quỷ Bí Ẩn (50 Coin)
    delete {_bLore::*}
    set {_bLore::1} to "&8&m----------------------------------------"
    set {_bLore::2} to "&7Trái Ác Quỷ thô thu thập từ vùng biển sâu,"
    set {_bLore::3} to "&7chứa cấu trúc gen của 8 loại năng lực tối thượng."
    set {_bLore::4} to ""
    set {_bLore::5} to "&6&l✦ CHI PHÍ MUA TRÁI BÍ ẨN:"
    set {_bLore::6} to "&f• Giá: &650 Coin &8(Đổi tại /nganhang)"
    set {_bLore::7} to ""
    set {_bLore::8} to "&a▶ Nhấp để sở hữu Trái Bí Ẩn!"
    set {_bLore::9} to "&8&m----------------------------------------"
    set {_bItem} to makeCustomRPItem("generic_fruit_1", "&d&l✦ MUA TRÁI ÁC QUỶ BÍ ẨN ✦", {_bLore::*})
    set slot 20 of {_inv} to {_bItem}

    # Slot 22 (TÂM): Lò Giám Định Vegapunk
    delete {_appLore::*}
    set {_appLore::1} to "&8&m----------------------------------------"
    set {_appLore::2} to "&7Phân tách cấu trúc gen của &dTrái Ác Quỷ Bí Ẩn"
    set {_appLore::3} to "&7thành Trái Ác Quỷ hoàn chỉnh và ghi danh Đồ Giám."
    set {_appLore::4} to ""
    set {_appLore::5} to "&6&l✦ TỶ LỆ XUẤT HIỆN:"
    set {_appLore::6} to "&f• &b70%% Nhóm Sử Thi: &fMera, Gomu, Ope, Seiryu"
    set {_appLore::7} to "&f• &d30%% Huyền Thoại Tier S: &eGura, Pika, Goro, Phoenix"
    set {_appLore::8} to ""
    set {_appLore::9} to "&6&l✦ CHI PHÍ MỖI LẦN:"
    set {_appLore::10} to "&f• &a$50,000 &8| &b5 Điểm Thiên Phú (TP)"
    set {_appLore::11} to ""
    set {_appLore::12} to "&e• Chuột Trái:&f Giám định 1 trái trên tay/trong túi"
    set {_appLore::13} to "&e• Chuột Phải:&f Giám định nhanh &6TOÀN BỘ&f trái bí ẩn"
    set {_appLore::14} to "&8&m----------------------------------------"
    set {_appItem} to makeCustomRPItem("generic_fruit_2", "&d&l✦ LÒ GIÁM ĐỊNH VEGAPUNK ✦", {_appLore::*})
    set slot 22 of {_inv} to {_appItem}

    # Slot 24: Mua Viên Biến Hình Rumble Ball
    delete {_rbLore::*}
    set {_rbLore::1} to "&8&m----------------------------------------"
    set {_rbLore::2} to "&7Dược liệu cường hóa biến hình Zoan trong 25s:"
    set {_rbLore::3} to "&f• &b-25%% Thời gian hồi chiêu toàn kỹ năng"
