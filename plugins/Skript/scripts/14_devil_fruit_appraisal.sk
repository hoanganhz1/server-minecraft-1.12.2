    set {_rbItem} to makeCustomRPItem("rumble_ball", "&e&l✦ MUA RUMBLE BALL ZOAN ✦", {_rbLore::*})
    set slot 24 of {_inv} to {_rbItem}

    # Slot 29: Điều Chế Thuốc Xóa Trái Ác Quỷ
    delete {_rmLore::*}
    set {_rmLore::1} to "&8&m----------------------------------------"
