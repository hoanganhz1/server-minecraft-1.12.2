    set {_rmLore::3} to "&7khôi phục 100%% nội tại Vô Quả Giả mà không bị nổ chết."
    set {_rmLore::4} to ""
    set {_rmLore::5} to "&6&l✦ CHI PHÍ ĐIỀU CHẾ:"
    set {_rmLore::6} to "&f• Tiền mặt: &a$100,000"
    set {_rmLore::7} to "&f• Nguyên liệu: &52x Tinh Hoa Ác Quỷ"
    set {_rmLore::8} to ""
    set {_rmLore::9} to "&a▶ Nhấp chuột để điều chế!"
    set {_rmLore::10} to "&8&m----------------------------------------"
    set {_rmItem} to makeCustomPotion(8388736, "&5&l✦ ĐIỀU CHẾ THUỐC XÓA TRÁI ✦", {_rmLore::*})
    set slot 29 of {_inv} to {_rmItem}

    # Slot 31: Chế Tạo Đá Thức Tỉnh Ác Quỷ 3D
    delete {_awkLore::*}
    set {_awkLore::1} to "&8&m----------------------------------------"
    set {_awkLore::2} to "&7Dùng để &6&lTHỨC TỈNH TRÁI ÁC QUỶ &7hoặc &aVÕ HỌC"
    set {_awkLore::3} to "&7khi đạt &bMastery Lv.100 &7mở khóa tiềm năng tối thượng."
    set {_awkLore::4} to ""
    set {_awkLore::5} to "&6&l✦ CHI PHÍ RÈN ĐÁ:"
    set {_awkLore::6} to "&f• Tiền mặt: &a$250,000"
    set {_awkLore::7} to "&f• Nguyên liệu: &55x Tinh Hoa Ác Quỷ"
    set {_awkLore::8} to ""
    set {_awkLore::9} to "&a▶ Nhấp để rèn Đá Thức Tỉnh!"
    set {_awkLore::10} to "&8&m----------------------------------------"
    set {_awkItem} to makeCustomRPItem("skill_awaken", "&e&l✦ CHẾ TẠO ĐÁ THỨC TỈNH ✦", {_awkLore::*})
    set slot 31 of {_inv} to {_awkItem}

    # Slot 33: Hợp Thành Bùa Thức Tỉnh Tinh Tú
    delete {_talLore::*}
    set {_talLore::1} to "&8&m----------------------------------------"
    set {_talLore::2} to "&7Bùa chú thượng cổ dung hợp tinh hoa tinh tú,"
    set {_talLore::3} to "&7đảm bảo &a100%% thành công &7khi thức tỉnh."
    set {_talLore::4} to ""
    set {_talLore::5} to "&6&l✦ NGUYÊN LIỆU HỢP THÀNH:"
    set {_talLore::6} to "&f• &55x Tinh Hoa Ác Quỷ"
    set {_talLore::7} to "&f• &e1x Đá Thức Tỉnh"
    set {_talLore::8} to ""
    set {_talLore::9} to "&a▶ Nhấp để hợp thành Bùa Thức Tỉnh!"
    set {_talLore::10} to "&8&m----------------------------------------"
    set {_talItem} to makeGlowingItem(paper, "&6&l✦ HỢP THÀNH BÙA THỨC TỈNH TINH TÚ ✦", {_talLore::*})
    set slot 33 of {_inv} to {_talItem}

    # Slot 40: Máy Chiết Xuất Tinh Hoa Ác Quỷ
    delete {_extLore::*}
    set {_extLore::1} to "&8&m----------------------------------------"
    set {_extLore::2} to "&7Phân rã các Trái Ác Quỷ thừa hoặc trùng lặp"
    set {_extLore::3} to "&7thành &5Tinh Hoa Ác Quỷ &7để tái sử dụng."
    set {_extLore::4} to ""
    set {_extLore::5} to "&6&l✦ TỶ LỆ QUY ĐỔI:"
    set {_extLore::6} to "&f• 1 Trái Ác Quỷ bất kỳ &f▶ &51x Tinh Hoa Ác Quỷ"
    set {_extLore::7} to ""
    set {_extLore::8} to "&e• Chuột Trái:&7 Phân rã &e1 trái&7 thừa trong túi"
    set {_extLore::9} to "&e• Chuột Phải:&7 Phân rã nhanh &6TOÀN BỘ&7 trái thừa"
    set {_extLore::10} to "&8&m----------------------------------------"
    set {_extItem} to makeGlowingItem(cauldron, "&d&l✦ MÁY CHIẾT XUẤT TINH HOA ✦", {_extLore::*})
    set slot 40 of {_inv} to {_extItem}

    # Slot 49: Số Lượng Tinh Hoa Hiện Có
    delete {_sumLore::*}
    set {_sumLore::1} to "&8&m----------------------------------------"
    set {_sumLore::2} to "&7Số lượng trong túi đồ: &5%{_essenceCount}% Tinh Hoa"
    set {_sumLore::3} to ""
    set {_sumLore::4} to "&6&l✦ HỆ SINH THÁI KINH TẾ ÁC QUỶ:"
    set {_sumLore::5} to "&f• Rương Thần Thoại: &e10 Tinh Hoa + $500k"
    set {_sumLore::6} to "&f• Thuốc Xóa Trái: &e2 Tinh Hoa + $100k"
    set {_sumLore::7} to "&f• Đá Thức Tỉnh: &e5 Tinh Hoa + $250k"
    set {_sumLore::8} to "&f• Bùa Thức Tỉnh: &e5 Tinh Hoa + 1 Đá"
    set {_sumLore::9} to "&f• Rumble Ball: &e1 Tinh Hoa + $25k"
    set {_sumLore::10} to "&8&m----------------------------------------"
    set {_sumItem} to makeGlowingItem(purple dye, "&5&l✦ VÍ TINH HOA ÁC QUỶ ✦", {_sumLore::*})
    set slot 49 of {_inv} to {_sumItem}

    openStandardUI({_p}, {_inv}, "UI_G1_C", "UI_G1")

# ---------------------------------------------------------------------
# 6. XỬ LÝ SỰ KIỆN CLICK GUI VEGAPUNK (UI_G1_C) & POKEDEX (UI_G1_D)
# ---------------------------------------------------------------------

on InventoryDragEvent:
    set {_who} to event.getWhoClicked()
    if {_who} is set:
        set {_active} to {ui_active::%uuid of {_who}%}
        if {_active} is "UI_G1_C" or "UI_G1_D":
            cancel event

on inventory click:
    set {_p} to player
    set {_u} to uuid of {_p}

    if {ui_active::%{_u}%} is "UI_G1_D":
        cancel event
        if "%click type%" contains "SHIFT" or "NUMBER" or "DOUBLE" or "SWAP" or "DROP":
            player.updateInventory()
        if clicked inventory is not player's current inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 45 or 46 or 53:
            stop
        stop

    if {ui_active::%{_u}%} is not "UI_G1_C":
        stop

    cancel event
    if "%click type%" contains "SHIFT" or "NUMBER" or "DOUBLE" or "SWAP" or "DROP":
        player.updateInventory()
    if clicked inventory is not player's current inventory:
        stop

    set {_slot} to index of event-slot
    if {_slot} is 45 or 46 or 53:
        stop
    set {_clickType} to "%click type%"

    # 1. Slot 13: Đổi Rương Trái Thần Thoại (10 Tinh Hoa + $500,000)
    if {_slot} is 13:
        if {_p}'s balance < 500000:
            sendSystemMsg({_p}, "economy", "Bạn không đủ tiền! Cần &a$500,000&f.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if countPlayerItemByTag({_p}, "df_essence") < 10:
            sendSystemMsg({_p}, "warning", "Cần &510x Tinh Hoa Ác Quỷ&f trong túi đồ để đổi rương!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if removePlayerItemByTag({_p}, "df_essence", 10) is false:
            sendSystemMsg({_p}, "warning", "Không thể trừ Tinh Hoa Ác Quỷ!")
            stop
        remove 500000 from {_p}'s balance
        set {_chest} to getRandomFruitChestItem()
        if {_p} can hold {_chest}:
            give {_chest} to {_p}
        else:
            drop {_chest} at location of {_p}
            sendSystemMsg({_p}, "warning", "Túi đồ đầy! Rương đã rơi xuống chân bạn.")
        sendSystemMsg({_p}, "training", "Đổi thành công &6Rương Trái Ác Quỷ Thần Bí&f!")
        play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.2 to {_p}
        openAppraisalGUI({_p})

    # 2. Slot 20: Mua Trái Ác Quỷ Bí Ẩn (50 Coin)
    else if {_slot} is 20:
        if getCoinBalance({_p}) < 50:
            sendSystemMsg({_p}, "error", "Bạn thiếu Coin! Cần 50 Coin để mua Trái Bí Ẩn (Đổi tại /nganhang).")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        takeCoinBalance({_p}, 50)
        set {_unFruit} to getUnidentifiedFruitItem()
        giveItemSafely({_p}, {_unFruit})
        sendSystemMsg({_p}, "economy", "Đã thanh toán 50 Coin mua Trái Bí Ẩn thành công!")
        play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to {_p}
        openAppraisalGUI({_p})

    # 3. Slot 22: Lò Giám Định Vegapunk ($50,000 + 5 TP)
    else if {_slot} is 22:
        # Chuột Phải: Giám định TOÀN BỘ trái bí ẩn
        if {_clickType} contains "RIGHT":
            set {_availCount} to countPlayerItemByTag({_p}, "unidentified_df")
            if {_availCount} < 1:
                sendSystemMsg({_p}, "warning", "Bạn không có Trái Ác Quỷ Bí Ẩn nào trong túi đồ!")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
                stop

            set {_totalAppraised} to 0
            loop {_availCount} times:
                if countPlayerItemByTag({_p}, "unidentified_df") < 1:
                    exit loop
                if {_p}'s balance < 50000:
                    sendSystemMsg({_p}, "economy", "Hết tiền giám định tiếp!")
                    exit loop
                if ({talent::%{_u}%::points} ? 0) < 5:
                    sendSystemMsg({_p}, "talent", "Hết Điểm Thiên Phú để giám định tiếp!")
                    exit loop

                if removePlayerItemByTag({_p}, "unidentified_df", 1) is false:
                    exit loop

                remove 50000 from {_p}'s balance
                subtract 5 from {talent::%{_u}%::points}

                set {_roll} to random integer between 1 and 100
                set {_resFruit} to "mera"
                set {_isTierS} to false
                if {_roll} <= 70:
                    set {_epicPool::1} to "mera"
                    set {_epicPool::2} to "gomu"
                    set {_epicPool::3} to "ope"
                    set {_epicPool::4} to "seiryu"
                    set {_resFruit} to random element out of {_epicPool::*}
                else:
                    set {_isTierS} to true
                    set {_mythicPool::1} to "gura"
                    set {_mythicPool::2} to "pika"
                    set {_mythicPool::3} to "goro"
                    set {_mythicPool::4} to "phoenix"
                    set {_resFruit} to random element out of {_mythicPool::*}

                set {_resItem} to getDevilFruitItem({_resFruit})
                if {_p} can hold {_resItem}:
                    give {_resItem} to {_p}
                else:
                    drop {_resItem} at location of {_p}
                registerFruitToPokedex({_p}, {_resFruit})
                add 1 to {_totalAppraised}

            if {_totalAppraised} > 0:
                sendSystemMsg({_p}, "training", "Đã giám định hoàn tất &b%{_totalAppraised}% Trái Ác Quỷ&f!")
                play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1 to {_p}
            openAppraisalGUI({_p})

        # Chuột Trái: Giám định 1 trái (kiểm tra 3 điều kiện TRƯỚC khi trừ vật phẩm)
        else:
            if countPlayerItemByTag({_p}, "unidentified_df") < 1:
                sendSystemMsg({_p}, "warning", "Bạn không có Trái Ác Quỷ Bí Ẩn nào trong túi đồ!")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
                stop

            if {_p}'s balance < 50000:
                sendSystemMsg({_p}, "economy", "Bạn không đủ tiền giám định! Cần &a$50,000&f.")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
                stop

            if ({talent::%{_u}%::points} ? 0) < 5:
                sendSystemMsg({_p}, "talent", "Bạn không đủ Điểm Thiên Phú! Cần &b5 TP&f.")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
                stop

            if removePlayerItemByTag({_p}, "unidentified_df", 1) is false:
                sendSystemMsg({_p}, "warning", "Không thể lấy Trái Ác Quỷ Bí Ẩn khỏi túi đồ!")
                stop

            remove 50000 from {_p}'s balance
            subtract 5 from {talent::%{_u}%::points}

            set {_roll} to random integer between 1 and 100
            set {_resFruit} to "mera"
            set {_isTierS} to false

            if {_roll} <= 70:
                set {_epicPool::1} to "mera"
                set {_epicPool::2} to "gomu"
                set {_epicPool::3} to "ope"
                set {_epicPool::4} to "seiryu"
                set {_resFruit} to random element out of {_epicPool::*}
            else:
                set {_isTierS} to true
                set {_mythicPool::1} to "gura"
                set {_mythicPool::2} to "pika"
                set {_mythicPool::3} to "goro"
                set {_mythicPool::4} to "phoenix"
                set {_resFruit} to random element out of {_mythicPool::*}

            set {_resultItem} to getDevilFruitItem({_resFruit})
            set {_resName} to getDevilFruitDisplayName({_resFruit})

            if {_p} can hold {_resultItem}:
                give {_resultItem} to {_p}
            else:
                drop {_resultItem} at location of {_p}
                sendSystemMsg({_p}, "warning", "Túi đồ đầy! Trái Ác Quỷ đã rơi xuống chân bạn.")

            registerFruitToPokedex({_p}, {_resFruit})

            set {_pName} to name of {_p}
            if {_isTierS} is true:
                broadcastDualCard("&d&l✦ GIÁM ĐỊNH HUYỀN THOẠI", "%{_pName}% đã giám định thành công Trái Tier S %{_resName}%!", "Sức mạnh tối thượng của Đại Hải Trình chính thức thức tỉnh!")
                play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1.5 and pitch 0.8 to {_p}
                spawnVisualParticle("EXPLOSION_LARGE", location of {_p}, 15, 0.8, 1.2, 0.8, 0.1)
                spawnVisualParticle("TOTEM", location of {_p}, 30, 0.6, 1.0, 0.6, 0.2)
            else:
                sendSystemMsg({_p}, "training", "Giám định thành công! Bạn nhận được &e%{_resName}%&f.")
                play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to {_p}
            openAppraisalGUI({_p})

    # 4. Slot 24: Mua Rumble Ball ($25,000 + 1 Tinh Hoa)
    else if {_slot} is 24:
        set {_buyAmount} to 1
        set {_costMoney} to 25000
        set {_costEssence} to 1
        if {_clickType} contains "RIGHT":
            set {_buyAmount} to 5
            set {_costMoney} to 125000
            set {_costEssence} to 5

        if {_p}'s balance < {_costMoney}:
            sendSystemMsg({_p}, "economy", "Bạn không đủ tiền! Cần &a$%{_costMoney}%&f.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop

        if countPlayerItemByTag({_p}, "df_essence") < {_costEssence}:
            sendSystemMsg({_p}, "warning", "Cần &5%{_costEssence}%x Tinh Hoa Ác Quỷ&f trong túi đồ!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop

        if removePlayerItemByTag({_p}, "df_essence", {_costEssence}) is false:
            sendSystemMsg({_p}, "warning", "Không thể trừ Tinh Hoa Ác Quỷ!")
            stop

        remove {_costMoney} from {_p}'s balance
        set {_rbItem} to getRumbleBallItem()
        set item amount of {_rbItem} to {_buyAmount}
        if {_p} can hold {_rbItem}:
            give {_rbItem} to {_p}
        else:
            drop {_rbItem} at location of {_p}
            sendSystemMsg({_p}, "warning", "Túi đồ đầy! Rumble Ball đã rơi xuống chân bạn.")
        sendSystemMsg({_p}, "training", "Đã mua &e%{_buyAmount}%x Rumble Ball&f thành công!")
        play sound "ENTITY_PLAYER_LEVELUP" with volume 1 and pitch 1.2 to {_p}
        openAppraisalGUI({_p})

    # 5. Slot 29: Điều Chế Thuốc Xóa Trái Ác Quỷ ($100,000 + 2 Tinh Hoa)
    else if {_slot} is 29:
        if {_p}'s balance < 100000:
            sendSystemMsg({_p}, "economy", "Bạn không đủ tiền! Cần &a$100,000&f.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if countPlayerItemByTag({_p}, "df_essence") < 2:
            sendSystemMsg({_p}, "warning", "Cần &52x Tinh Hoa Ác Quỷ&f trong túi đồ để điều chế!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if removePlayerItemByTag({_p}, "df_essence", 2) is false:
            sendSystemMsg({_p}, "warning", "Không thể trừ Tinh Hoa Ác Quỷ!")
            stop
        remove 100000 from {_p}'s balance
        set {_rm} to getFruitRemoverItem()
        if {_p} can hold {_rm}:
            give {_rm} to {_p}
        else:
            drop {_rm} at location of {_p}
            sendSystemMsg({_p}, "warning", "Túi đồ đầy! Thuốc Xóa Trái đã rơi xuống chân bạn.")
        sendSystemMsg({_p}, "training", "Điều chế thành công &5Thuốc Xóa Trái Ác Quỷ&f!")
        play sound "BLOCK_BREWING_STAND_BREW" with volume 1 and pitch 1 to {_p}
        openAppraisalGUI({_p})

    # 6. Slot 31: Chế Tạo Đá Thức Tỉnh Ác Quỷ ($250,000 + 5 Tinh Hoa)
    else if {_slot} is 31:
        if {_p}'s balance < 250000:
            sendSystemMsg({_p}, "economy", "Bạn không đủ tiền! Cần &a$250,000&f.")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if countPlayerItemByTag({_p}, "df_essence") < 5:
            sendSystemMsg({_p}, "warning", "Cần &55x Tinh Hoa Ác Quỷ&f trong túi đồ để rèn Đá!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if removePlayerItemByTag({_p}, "df_essence", 5) is false:
            sendSystemMsg({_p}, "warning", "Không thể trừ Tinh Hoa Ác Quỷ!")
            stop
        remove 250000 from {_p}'s balance
        set {_stone} to getAwakeningStoneItem()
        if {_p} can hold {_stone}:
            give {_stone} to {_p}
        else:
            drop {_stone} at location of {_p}
            sendSystemMsg({_p}, "warning", "Túi đồ đầy! Đá Thức Tỉnh đã rơi xuống chân bạn.")
        sendSystemMsg({_p}, "training", "Chế tạo thành công &eĐá Thức Tỉnh Ánh Sao&f!")
        play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.2 to {_p}
        openAppraisalGUI({_p})

    # 7. Slot 33: Hợp Thành Bùa Thức Tỉnh Tinh Tú (5 Tinh Hoa + 1 Đá Thức Tỉnh)
    else if {_slot} is 33:
        if countPlayerItemByTag({_p}, "df_essence") < 5:
            sendSystemMsg({_p}, "warning", "Cần &55x Tinh Hoa Ác Quỷ&f trong túi đồ!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if countPlayerItemByTag({_p}, "awakening_stone") < 1:
            sendSystemMsg({_p}, "warning", "Cần &61x Đá Thức Tỉnh&f trong túi đồ để hợp thành Bùa!")
            play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            stop
        if removePlayerItemByTag({_p}, "df_essence", 5) is false:
            stop
        if removePlayerItemByTag({_p}, "awakening_stone", 1) is false:
            stop
        set {_talisman} to getAwakeningTalismanItem()
        if {_p} can hold {_talisman}:
            give {_talisman} to {_p}
        else:
            drop {_talisman} at location of {_p}
            sendSystemMsg({_p}, "warning", "Túi đồ đầy! Bùa Thức Tỉnh đã rơi xuống chân bạn.")
        sendSystemMsg({_p}, "training", "Hợp thành thành công &6Bùa Thức Tỉnh Tinh Tú&f!")
        play sound "UI_TOAST_CHALLENGE_COMPLETE" with volume 1 and pitch 1.5 to {_p}
        openAppraisalGUI({_p})

    # 8. Slot 40: Máy Chiết Xuất Tinh Hoa Ác Quỷ (Phân rã trái thừa)
    else if {_slot} is 40:
        # Chuột Phải: Phân rã TOÀN BỘ trái thừa
        if {_clickType} contains "RIGHT":
            set {_dissolvedCount} to 0
            loop integers from 0 to 40:
                set {_it} to slot loop-integer of {_p}'s inventory
                if {_it} is set:
                    if {_it} is not air:
                        if type of {_it} is not air:
                            set {_dfTag} to string tag "DevilFruit" of nbt compound of {_it}
                            if {_dfTag} is set:
                                if {_dfTag} is not "":
                                    set {_amt} to item amount of {_it}
                                    add {_amt} to {_dissolvedCount}
                                    set slot loop-integer of {_p}'s inventory to air
                                    registerFruitToPokedex({_p}, {_dfTag})

            if {_dissolvedCount} > 0:
                set {_essItem} to getDevilFruitEssenceItem()
                set item amount of {_essItem} to {_dissolvedCount}
                if {_p} can hold {_essItem}:
                    give {_essItem} to {_p}
                else:
                    drop {_essItem} at location of {_p}
                sendSystemMsg({_p}, "training", "Đã chiết xuất &b%{_dissolvedCount}% Trái Ác Quỷ&f thành &5%{_dissolvedCount}% Tinh Hoa Ác Quỷ&f!")
                play sound "BLOCK_BREWING_STAND_BREW" with volume 1 and pitch 1.2 to {_p}
            else:
                sendSystemMsg({_p}, "warning", "Không tìm thấy Trái Ác Quỷ nào trong túi đồ để chiết xuất!")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            openAppraisalGUI({_p})

        # Chuột Trái: Phân rã 1 trái
        else:
            set {_dissolved} to false
            loop integers from 0 to 40:
                set {_it} to slot loop-integer of {_p}'s inventory
                if {_it} is set:
                    if {_it} is not air:
                        if type of {_it} is not air:
                            set {_dfTag} to string tag "DevilFruit" of nbt compound of {_it}
                            if {_dfTag} is set:
                                if {_dfTag} is not "":
                                    set {_amt} to item amount of {_it}
                                    if {_amt} <= 1:
                                        set slot loop-integer of {_p}'s inventory to air
                                    else:
                                        set item amount of (slot loop-integer of {_p}'s inventory) to ({_amt} - 1)
                                    registerFruitToPokedex({_p}, {_dfTag})
                                    set {_dissolved} to true
                                    exit loop

            if {_dissolved} is true:
                set {_essItem} to getDevilFruitEssenceItem()
                if {_p} can hold {_essItem}:
                    give {_essItem} to {_p}
                else:
                    drop {_essItem} at location of {_p}
                sendSystemMsg({_p}, "training", "Đã chiết xuất &b1 Trái Ác Quỷ&f thành &51 Tinh Hoa Ác Quỷ&f!")
                play sound "BLOCK_BREWING_STAND_BREW" with volume 1 and pitch 1.2 to {_p}
            else:
                sendSystemMsg({_p}, "warning", "Bạn không có Trái Ác Quỷ nào trong túi đồ để chiết xuất!")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to {_p}
            openAppraisalGUI({_p})

# ---------------------------------------------------------------------
# 7. SỬ DỤNG RUMBLE BALL & SÁCH ĐỒ GIÁM KHI CLICK PHẢI
# ---------------------------------------------------------------------

function isZoanRumbleActive(p: player) :: boolean:
    if {_p} is not online:
        return false
    set {_u} to uuid of {_p}
    set {_endTime} to {rumble_ball_end::%{_u}%} ? 0
    if System.currentTimeMillis() < {_endTime}:
        return true
    return false

on rightclick:
    set {_tool} to player's tool
    if isValidItem({_tool}) is true:
        set {_tag} to string tag "SkyblockItem" of nbt compound of {_tool}

        # 1. Click mở Bách Khoa Toàn Thư
        if {_tag} is "df_encyclopedia":
            cancel event
            openPokedexGUI(player)
            stop

        # 2. Click sử dụng Rumble Ball
        else if {_tag} is "rumble_ball":
            cancel event
            set {_u} to uuid of player

            # Kiểm tra xem có Trái Zoan không (Bản thân hoặc Đệ Tử)
            set {_hasZoan} to false
            if {df_data::%{_u}%::fruit} is "seiryu" or "phoenix":
                set {_hasZoan} to true
            if {disciple::%{_u}%::style} is "seiryu" or "phoenix":
                set {_hasZoan} to true

            if {_hasZoan} is not true:
                sendSystemMsg(player, "warning", "Rumble Ball chỉ có tác dụng với người hoặc Đệ Tử mang Trái Hệ Zoan (Seiryu / Phoenix)!")
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
                stop

            set {_nowMs} to System.currentTimeMillis()
            set {_lastUse} to {rumble_ball_cd::%{_u}%} ? 0
            if ({_nowMs} - {_lastUse}) < 90000:
                set {_remSec} to round((90000 - ({_nowMs} - {_lastUse})) / 1000)
                send action bar "&c[Rumble Ball] Đang hồi! Chờ &e%{_remSec}%s&c nữa." to player
                play sound "ENTITY_VILLAGER_NO" with volume 1 and pitch 1 to player
                stop

            # Tiêu hao 1 viên
            if item amount of {_tool} <= 1:
                set player's tool to air
            else:
                set item amount of {_tool} to (item amount of {_tool} - 1)
                set player's tool to {_tool}

            set {rumble_ball_cd::%{_u}%} to {_nowMs}
            set {rumble_ball_end::%{_u}%} to {_nowMs} + 60000
            set {rumble_ball_def::%{_u}%} to {_nowMs} + 60000
            apply speed 1 to player for 60 seconds

            send action bar "&6&l✦ RUMBLE BALL: CƯỜNG HÓA BIẾN HÌNH ZOAN (60s)! ✦" to player
            play sound "ENTITY_ENDERDRAGON_GROWL" with volume 1.2 and pitch 1.2 to player
            set {_pLoc} to location of player
            add 1 to y-coordinate of {_pLoc}
            spawnVisualParticle("DRAGON_BREATH", {_pLoc}, 30, 0.6, 0.8, 0.6, 0.1)
            spawnVisualParticle("FIREWORKS_SPARK", {_pLoc}, 20, 0.5, 0.5, 0.5, 0.08)

# ---------------------------------------------------------------------
# 8. LỆNH NGƯỜI CHƠI & LỆNH QUẢN TRỊ ADMIN
# ---------------------------------------------------------------------

command /giamdinh:
    aliases: /appraise, /vegapunk
    trigger:
        openAppraisalGUI(player)

command /bachkhoatrai:
    aliases: /pokedex, /dfpokedex, /encyclopedia
    trigger:
        openPokedexGUI(player)

command /giveunidentified [<player>]:
    permission: op
    permission message: &cBạn không có quyền sử dụng lệnh này!
    trigger:
        set {_p} to arg-1 ? player
        giveUnidentifiedFruit({_p})
        send "&a[Vegapunk] Đã trao 1 Trái Ác Quỷ Chưa Giám Định cho %name of {_p}%!" to player

command /traibian [<player>]:
    permission: op
    permission message: &cBạn không có quyền sử dụng lệnh này!
    trigger:
        set {_p} to arg-1 ? player
        giveUnidentifiedFruit({_p})
        send "&a[Vegapunk] Đã trao 1 Trái Ác Quỷ Chưa Giám Định cho %name of {_p}%!" to player

command /dfextadmin [<text>] [<player>] [<text>]:
    permission: op
    permission message: &cBạn không có quyền quản trị Giám Định!
    trigger:
        if arg-1 is "giveunidentified":
            set {_p} to arg-2 ? player
            giveUnidentifiedFruit({_p})
            send "&aĐã trao Trái Ác Quỷ Bí Ẩn cho %name of {_p}%!" to player

        else if arg-1 is "giverumble":
            set {_p} to arg-2 ? player
            set {_rb} to getRumbleBallItem()
            if {_p} can hold {_rb}:
                give {_rb} to {_p}
            else:
                drop {_rb} at location of {_p}
            send "&aĐã trao Rumble Ball cho %name of {_p}%!" to player

        else if arg-1 is "giveencyclopedia":
            set {_p} to arg-2 ? player
            set {_enc} to getEncyclopediaItem()
            if {_p} can hold {_enc}:
                give {_enc} to {_p}
            else:
                drop {_enc} at location of {_p}
            send "&aĐã trao Đồ Giám Trái Ác Quỷ cho %name of {_p}%!" to player

        else if arg-1 is "giveessence":
            set {_p} to arg-2 ? player
            set {_ess} to getDevilFruitEssenceItem()
            if {_p} can hold {_ess}:
                give {_ess} to {_p}
            else:
                drop {_ess} at location of {_p}
            send "&aĐã trao 1x Tinh Hoa Ác Quỷ cho %name of {_p}%!" to player

        else if arg-1 is "givetalisman":
            set {_p} to arg-2 ? player
            set {_tal} to getAwakeningTalismanItem()
            if {_p} can hold {_tal}:
                give {_tal} to {_p}
            else:
                drop {_tal} at location of {_p}
            send "&aĐã trao 1x Bùa Thức Tỉnh Tinh Tú cho %name of {_p}%!" to player

        else:
            send "&6&l✦ HỆ THỐNG QUẢN TRỊ GIÁM ĐỊNH & EXTENSION ✦" to player
            send "&e• /dfextadmin giveunidentified [<player>]" to player
            send "&e• /dfextadmin giverumble [<player>]" to player
            send "&e• /dfextadmin giveencyclopedia [<player>]" to player
            send "&e• /dfextadmin giveessence [<player>]" to player
            send "&e• /dfextadmin givetalisman [<player>]" to player
