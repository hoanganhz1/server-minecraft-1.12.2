    - '&8&m------------------------------'
    - '&7Tài khoản: &f{player}'
    - '&7Rank hiện tại: %talent_rank%'
    - '&7Số dư Money: &a${money}'
    - '&7Số dư Coin: &6%playerpoints_points% Coin'
    - '&8&m------------------------------'
  POSITION-X: 5
  POSITION-Y: 1
  KEEP-OPEN: true

